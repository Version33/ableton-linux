+/* Continue fast fine scrolling or a middle drag after a confirmed release.
+ *
+ * State and wheel output stay on the owning interface thread. A timer thread
+ * only posts WM_X11DRV_POINTER_TICK to that thread. The application does not
+ * receive this private message, and a late tick finds cancelled state idle.
+ */
+
+#define INERTIA_HISTORY_MS   100     /* history used to calculate release speed */
+#define INERTIA_DEADLINE_MS  100     /* abandon tracking without a matching release marker */
+#define INERTIA_RELEASE_GATE_MS 70   /* reject a release after the pointer has rested */
+#define INERTIA_TICK_MS      8
+#define INERTIA_MAX_FRAME_MS 16      /* discard movement from older missed frames */
+#define INERTIA_MAX_PACKET   (WHEEL_DELTA / 4)
+#define INERTIA_MAX_TRAVEL   (4 * WHEEL_DELTA)
+#define INERTIA_CAP_MS       3000    /* longest coast before the decay is forced steeper */
+#define INERTIA_CAP_RATE     14.0    /* decay rate used after the three-second cap */
+#define INERTIA_START_SPEED  240.0   /* wheel units per second, vector magnitude */
+#define INERTIA_STOP_SPEED   60.0
+#define INERTIA_MAX_SPEED    19200.0
+
+#define INERTIA_NUDGE_SLOTS 8
+
+static pthread_mutex_t inertia_nudge_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t inertia_nudge_cond = PTHREAD_COND_INITIALIZER;
+static struct
+{
+    struct
+    {
+        HWND   hwnd;      /* post target, 0 = free slot */
+        UINT64 fire_at;   /* CLOCK_MONOTONIC milliseconds */
+        UINT   interval;
+        BOOL   repeating; /* tracking expiry posts once; coast ticks repeat */
+    } slots[INERTIA_NUDGE_SLOTS];
+    BOOL running;
+    BOOL failed;
+} inertia_nudge;
+
+static UINT64 inertia_nudge_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (UINT64)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void CALLBACK inertia_nudge_thread( void *arg )
+{
+    pthread_mutex_lock( &inertia_nudge_mutex );
+    for (;;)
+    {
+        UINT64 now, min_fire = 0;
+        int i;
+
+        for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+            if (inertia_nudge.slots[i].hwnd &&
+                (!min_fire || inertia_nudge.slots[i].fire_at < min_fire))
+                min_fire = inertia_nudge.slots[i].fire_at;
+
+        if (!min_fire)
+        {
+            pthread_cond_wait( &inertia_nudge_cond, &inertia_nudge_mutex );
+            continue;
+        }
+
+        now = inertia_nudge_now();
+        if (now < min_fire)
+        {
+            struct timespec deadline;
+
+            deadline.tv_sec = min_fire / 1000;
+            deadline.tv_nsec = (min_fire % 1000) * 1000000;
+            pthread_cond_timedwait( &inertia_nudge_cond, &inertia_nudge_mutex, &deadline );
+            continue;  /* recompute: the slots may have changed either way */
+        }
+
+        for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+        {
+            HWND hwnd = inertia_nudge.slots[i].hwnd;
+            BOOL ok;
+
+            if (!hwnd || inertia_nudge.slots[i].fire_at > now) continue;
+            if (inertia_nudge.slots[i].repeating)
+                inertia_nudge.slots[i].fire_at = now + inertia_nudge.slots[i].interval;
+            else
+                inertia_nudge.slots[i].hwnd = 0;  /* one shot */
+            pthread_mutex_unlock( &inertia_nudge_mutex );
+            ok = NtUserPostMessage( hwnd, WM_X11DRV_POINTER_TICK, 0, 0 );
+            pthread_mutex_lock( &inertia_nudge_mutex );
+            if (!ok)  /* window gone: drop every schedule it holds */
+            {
+                int j;
+
+                for (j = 0; j < INERTIA_NUDGE_SLOTS; j++)
+                    if (inertia_nudge.slots[j].hwnd == hwnd) inertia_nudge.slots[j].hwnd = 0;
+            }
+        }
+    }
+}
+
+/***********************************************************************
+ *           inertia_nudge_arm
+ *
+ * Register or move one window's next tick. Slots are keyed by window, so
+ * trackers on different GUI threads schedule independently, and every
+ * access runs under the mutex. The timer thread only wakes when a schedule
+ * moves earlier than the slot held before; a deadline re-armed later
+ * needs no wake, because the sleep target was already sooner.
+ */
+static void inertia_nudge_arm( HWND hwnd, UINT interval, BOOL repeating )
+{
+    UINT64 fire_at;
+    int i, slot = -1, latest = -1;
+    BOOL wake;
+
+    if (!hwnd) return;
+    pthread_mutex_lock( &inertia_nudge_mutex );
+    if (!inertia_nudge.running && !inertia_nudge.failed)
+    {
+        pthread_condattr_t attr;
+        HANDLE thread;
+
+        /* the waits must not follow wall-clock steps (an ntp correction
+         * would stall a deadline or freeze a coast by the step size);
+         * reinitialising the static cond is safe here, before the only
+         * waiter thread exists */
+        if (!pthread_condattr_init( &attr ) &&
+            !pthread_condattr_setclock( &attr, CLOCK_MONOTONIC ))
+        {
+            pthread_cond_init( &inertia_nudge_cond, &attr );
+            pthread_condattr_destroy( &attr );
+        }
+
+        /* NtCreateThreadEx is what the unix side of ntdll exports; the
+         * thread must be a Wine thread to make win32u calls */
+        if (NtCreateThreadEx( &thread, THREAD_ALL_ACCESS, NULL, NtCurrentProcess(),
+                              inertia_nudge_thread, NULL, 0, 0, 0, 0, NULL ))
+        {
+            WARN( "failed to start the inertia nudge thread, inertia disabled\n" );
+            inertia_nudge.failed = TRUE;
+        }
+        else
+        {
+            NtClose( thread );
+            inertia_nudge.running = TRUE;
+        }
+    }
+    if (inertia_nudge.failed)
+    {
+        pthread_mutex_unlock( &inertia_nudge_mutex );
+        return;
+    }
+
+    for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+    {
+        if (inertia_nudge.slots[i].hwnd == hwnd) { slot = i; break; }
+        if (slot == -1 && !inertia_nudge.slots[i].hwnd) slot = i;
+        if (latest == -1 || inertia_nudge.slots[i].fire_at > inertia_nudge.slots[latest].fire_at)
+            latest = i;
+    }
+    if (slot == -1)
+    {
+        /* every slot belongs to another window: take over the schedule
+         * firing last; its tracker recovers on that thread's next input */
+        TRACE( "nudge slots full, dropping the schedule of %p\n", inertia_nudge.slots[latest].hwnd );
+        slot = latest;
+        inertia_nudge.slots[slot].hwnd = 0;
+    }
+
+    fire_at = inertia_nudge_now() + interval;
+    wake = !inertia_nudge.slots[slot].hwnd || fire_at < inertia_nudge.slots[slot].fire_at;
+    inertia_nudge.slots[slot].hwnd = hwnd;
+    inertia_nudge.slots[slot].fire_at = fire_at;
+    inertia_nudge.slots[slot].interval = interval;
+    inertia_nudge.slots[slot].repeating = repeating;
+    if (wake) pthread_cond_signal( &inertia_nudge_cond );
+    pthread_mutex_unlock( &inertia_nudge_mutex );
+}
+
+/* Drop one window's schedule. The timer thread wakes at the stale time and
+ * finds nothing due, so no signal is needed */
+static void inertia_nudge_stop( HWND hwnd )
+{
+    int i;
+
+    if (!hwnd) return;
+    pthread_mutex_lock( &inertia_nudge_mutex );
+    for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+        if (inertia_nudge.slots[i].hwnd == hwnd) inertia_nudge.slots[i].hwnd = 0;
+    pthread_mutex_unlock( &inertia_nudge_mutex );
+}
+
+static BOOL pointer_inertia_enabled(void)
+{
+    /* XInput2 does not distinguish a touchpad from a high-resolution or
+     * free-spinning wheel, so auto remains disabled. Fine scrolling also
+     * requires precise mode. Middle drags provide their own raw movement. */
+    return pointer_config.touchpad_inertia == POINTER_INERTIA_ENABLED;
+}
+
+/***********************************************************************
+ *           pointer_inertia_cancel
+ *
+ * Any real input or context change ends tracking and coasting: pointer
+ * motion, button and key input, focus loss, grabs, device changes. Runs on
+ * the owning thread, so a plain state write is enough.
+ */
+void pointer_inertia_cancel(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+
+    if (!data) return;
+    if (data->scroll_inertia.state == INERTIA_IDLE) return;
+    TRACE( "state %u cancelled\n", data->scroll_inertia.state );
+    data->scroll_inertia.state = INERTIA_IDLE;
+    data->scroll_inertia.count = 0;
+    inertia_nudge_stop( data->scroll_inertia.hwnd );
+}
+
+/***********************************************************************
+ *           pointer_inertia_sample
+ *
+ * Record one accepted smooth scroll report: the raw fractional wheel units
+ * in the sign they were sent, stamped with the event's own time. A report
+ * from another device restarts tracking, and new input replaces an active
+ * coast. Each sample re-arms the one-shot abandonment timer.
+ */
+static void pointer_inertia_sample( struct x11drv_thread_data *data, int sourceid, HWND hwnd,
+                                    POINT anchor, double dx, double dy, UINT time )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+    unsigned int i;
+    BOOL new_sequence;
+
+    if (!pointer_inertia_enabled()) return;
+
+    new_sequence = si->state != INERTIA_TRACKING || si->sourceid != sourceid || si->hwnd != hwnd;
+    if (si->state == INERTIA_COASTING ||
+        (si->state == INERTIA_TRACKING && (si->sourceid != sourceid || si->hwnd != hwnd)))
+    {
+        HWND old_hwnd = si->hwnd;
+
+        si->state = INERTIA_IDLE;
+        si->count = 0;
+        /* Do not leave the old window's repeating slot alive after the
+         * tracker switches source or target. */
+        inertia_nudge_stop( old_hwnd );
+    }
+    si->state = INERTIA_TRACKING;
+    si->sourceid = sourceid;
+    si->hwnd = hwnd;
+    if (new_sequence) si->anchor = anchor;
+    si->last_time = time;
+
+    if (si->count == INERTIA_HISTORY_SIZE)
+        si->pos = (si->pos + 1) % INERTIA_HISTORY_SIZE;
+    else
+        si->count++;
+    i = (si->pos + si->count - 1) % INERTIA_HISTORY_SIZE;
+    si->history[i].dx = dx;
+    si->history[i].dy = dy;
+    si->history[i].time = time;
+
+    /* An update is a mutex-protected write. The timer thread only wakes when
+     * a schedule moves earlier, and a deadline pushed
+     * later never does */
+    inertia_nudge_arm( hwnd, INERTIA_DEADLINE_MS, FALSE );
+}
+
+/***********************************************************************
+ *           pointer_inertia_evaluate
+ *
+ * Decide whether the release speed is high enough to coast. Calculate speed
+ * from accepted raw movement and the input events' own timestamps, so a late
+ * evaluation and wheel-unit rounding do not change it.
+ */
+static void pointer_inertia_evaluate( struct x11drv_thread_data *data, UINT now )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+    double sum_x = 0.0, sum_y = 0.0, vx, vy, speed;
+    UINT first = 0, last = 0, span;
+    unsigned int i, used = 0;
+
+    for (i = 0; i < si->count; i++)
+    {
+        unsigned int j = (si->pos + i) % INERTIA_HISTORY_SIZE;
+
+        if (si->last_time - si->history[j].time > INERTIA_HISTORY_MS) continue;
+        if (!used)
+        {
+            /* the first sample's delta accrued before the window opens;
+             * its timestamp anchors the span, its movement does not count */
+            first = si->history[j].time;
+            last = first;
+            used++;
+            continue;
+        }
+        last = si->history[j].time;
+        sum_x += si->history[j].dx;
+        sum_y += si->history[j].dy;
+        used++;
+    }
+
+    si->state = INERTIA_IDLE;
+    si->count = 0;
+
+    span = last - first;
+    if (used < 2 || span < 10) return;
+
+    vx = sum_x * 1000.0 / span;
+    vy = sum_y * 1000.0 / span;
+    speed = hypot( vx, vy );
+    if (speed < INERTIA_START_SPEED)
+    {
+        TRACE( "sequence ended at %f units/s, no coast\n", speed );
+        return;
+    }
+    if (speed > INERTIA_MAX_SPEED)
+    {
+        vx *= INERTIA_MAX_SPEED / speed;
+        vy *= INERTIA_MAX_SPEED / speed;
+    }
+
+    si->state = INERTIA_COASTING;
+    si->vx = si->v0x = vx;
+    si->vy = si->v0y = vy;
+    si->rem_x = si->rem_y = 0.0;
+    si->travel_x = si->travel_y = 0;
+    si->start_time = si->last_tick = now;
+
+    TRACE( "coast start velocity %f,%f units/s\n", vx, vy );
+
+    inertia_nudge_arm( si->hwnd, INERTIA_TICK_MS, TRUE );
+}
+
+/***********************************************************************
+ *           pointer_inertia_release
+ *
+ * A matching scroll marker or middle-button release ended the tracked
+ * sequence. Evaluate it immediately; silence alone never starts a coast.
+ */
+static void pointer_inertia_release( struct x11drv_thread_data *data, int sourceid, HWND hwnd, UINT time )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+
+    if (si->state != INERTIA_TRACKING || si->sourceid != sourceid || si->hwnd != hwnd) return;
+    if (time - si->last_time > INERTIA_RELEASE_GATE_MS)
+    {
+        /* the fingers rested before lifting: stopping precisely must stop
+         * precisely, however fast the movement before the rest was */
+        TRACE( "release from source %d after %u ms of rest, no coast\n",
+               sourceid, time - si->last_time );
+        si->state = INERTIA_IDLE;
+        si->count = 0;
+        inertia_nudge_stop( si->hwnd );
+        return;
+    }
+    TRACE( "release from source %d\n", sourceid );
+    inertia_nudge_stop( si->hwnd );
+    pointer_inertia_evaluate( data, time );
+}
+
+/* Treat a repeated cumulative value on a present scroll axis as a release
+ * marker. The source and window must match the tracked sequence. */
+static void pointer_inertia_stop_marker( struct x11drv_thread_data *data, int sourceid,
+                                         HWND hwnd, UINT time )
+{
+    if (!pointer_inertia_enabled()) return;
+    pointer_inertia_release( data, sourceid, hwnd, time );
+}
+
+/***********************************************************************
+ *           pointer_inertia_packet
+ *
+ * Bound one axis independently. Whole-unit output beyond the packet cap is
+ * discarded instead of becoming debt for a later tick; only its sub-unit
+ * remainder survives. Each coast can emit at most four notches per axis.
+ */
+static int pointer_inertia_packet( double *remainder, double *velocity, int *travel )
+{
+    int available = (int)*remainder;
+    int remaining = INERTIA_MAX_TRAVEL - *travel;
+    int delta;
+
+    *remainder -= available;
+    if (remaining <= 0)
+    {
+        *remainder = *velocity = 0.0;
+        return 0;
+    }
+
+    if (available > INERTIA_MAX_PACKET) delta = INERTIA_MAX_PACKET;
+    else if (available < -INERTIA_MAX_PACKET) delta = -INERTIA_MAX_PACKET;
+    else delta = available;
+    if (delta > remaining) delta = remaining;
+    else if (delta < -remaining) delta = -remaining;
+
+    *travel += abs( delta );
+    if (*travel >= INERTIA_MAX_TRAVEL) *remainder = *velocity = 0.0;
+    return delta;
+}
+
+/***********************************************************************
+ *           pointer_inertia_tick
+ *
+ * Runs on the owning thread for every timer tick. During tracking it abandons
+ * a sequence without a matching release marker. During coasting it reduces
+ * velocity over the full elapsed wall time, but
+ * integrates only the latest bounded frame so a stalled GUI thread cannot
+ * replay missed travel as one burst.
+ */
+void pointer_inertia_tick(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_inertia *si;
+    UINT now = NtGetTickCount();
+    UINT elapsed_ms, frame_ms;
+    double elapsed_dt, frame_dt, k = pointer_config.inertia_rate;
+    int delta;
+
+    if (!data) return;
+    si = &data->scroll_inertia;
+
+    switch (si->state)
+    {
+    case INERTIA_IDLE:
+        return;
+    case INERTIA_TRACKING:
+        if (now - si->last_time >= INERTIA_DEADLINE_MS)
+        {
+            /* Quiet is not proof of release. Only a same-value stop marker
+             * or a middle-button release may start a coast. */
+            si->state = INERTIA_IDLE;
+            si->count = 0;
+            inertia_nudge_stop( si->hwnd );
+        }
+        else  /* an early post, e.g. from a re-arm race: keep the deadline */
+            inertia_nudge_arm( si->hwnd, INERTIA_DEADLINE_MS - (now - si->last_time), FALSE );
+        return;
+    case INERTIA_COASTING:
+        break;
+    }
+
+    if (!(elapsed_ms = now - si->last_tick)) return;
+    frame_ms = elapsed_ms > INERTIA_MAX_FRAME_MS ? INERTIA_MAX_FRAME_MS : elapsed_ms;
+    elapsed_dt = elapsed_ms / 1000.0;
+    frame_dt = frame_ms / 1000.0;
+    si->last_tick = now;
+
+    /* after the cap, a steeper decay takes any remaining velocity to the
+     * stop floor within about 300 ms. the default rate reaches the floor
+     * before the cap. only slow custom InertiaRate settings use the raised
+     * rate */
+    if (now - si->start_time > INERTIA_CAP_MS && k < INERTIA_CAP_RATE) k = INERTIA_CAP_RATE;
+
+    if (pointer_config.inertia_curve == POINTER_INERTIA_CURVE_LINEAR)
+    {
+        /* Decay across the full interval, then integrate only its most recent
+         * bounded frame. Missed frames are deliberately discarded. */
+        double before_dt = elapsed_dt - frame_dt;
+        double rate_x = k * fabs( si->v0x ), rate_y = k * fabs( si->v0y );
+        double frame_vx, frame_vy, new_vx, new_vy;
+
+        if (si->vx > 0)
+        {
+            frame_vx = si->vx - rate_x * before_dt > 0 ? si->vx - rate_x * before_dt : 0;
+            new_vx = si->vx - rate_x * elapsed_dt > 0 ? si->vx - rate_x * elapsed_dt : 0;
+        }
+        else if (si->vx < 0)
+        {
+            frame_vx = si->vx + rate_x * before_dt < 0 ? si->vx + rate_x * before_dt : 0;
+            new_vx = si->vx + rate_x * elapsed_dt < 0 ? si->vx + rate_x * elapsed_dt : 0;
+        }
+        else frame_vx = new_vx = 0;
+        if (si->vy > 0)
+        {
+            frame_vy = si->vy - rate_y * before_dt > 0 ? si->vy - rate_y * before_dt : 0;
+            new_vy = si->vy - rate_y * elapsed_dt > 0 ? si->vy - rate_y * elapsed_dt : 0;
+        }
+        else if (si->vy < 0)
+        {
+            frame_vy = si->vy + rate_y * before_dt < 0 ? si->vy + rate_y * before_dt : 0;
+            new_vy = si->vy + rate_y * elapsed_dt < 0 ? si->vy + rate_y * elapsed_dt : 0;
+        }
+        else frame_vy = new_vy = 0;
+        si->rem_x += (frame_vx + new_vx) / 2.0 * frame_dt;
+        si->rem_y += (frame_vy + new_vy) / 2.0 * frame_dt;
+        si->vx = new_vx;
+        si->vy = new_vy;
+    }
+    else
+    {
+        /* Decay across the full interval. Integrate only [elapsed-frame,
+         * elapsed], discarding any motion from earlier missed frames. */
+        double factor = exp( -k * elapsed_dt );
+        double frame_start = exp( -k * (elapsed_dt - frame_dt) );
+        double frame_factor = exp( -k * frame_dt );
+
+        si->rem_x += si->vx * frame_start * (1.0 - frame_factor) / k;
+        si->rem_y += si->vy * frame_start * (1.0 - frame_factor) / k;
+        si->vx *= factor;
+        si->vy *= factor;
+    }
+
+    if ((delta = pointer_inertia_packet( &si->rem_y, &si->vy, &si->travel_y )))
+    {
+        TRACE( "coast wheel %d\n", delta );
+        send_wheel_at_input( si->hwnd, si->anchor, MOUSEEVENTF_WHEEL, delta, now );
+    }
+    if ((delta = pointer_inertia_packet( &si->rem_x, &si->vx, &si->travel_x )))
+    {
+        TRACE( "coast hwheel %d\n", delta );
+        send_wheel_at_input( si->hwnd, si->anchor, MOUSEEVENTF_HWHEEL, delta, now );
+    }
+
+    if (hypot( si->vx, si->vy ) < INERTIA_STOP_SPEED ||
+        now - si->start_time > INERTIA_CAP_MS + 1000)  /* backstop after the raised decay rate */
+    {
+        TRACE( "coast ends at %f,%f units/s\n", si->vx, si->vy );
+        si->state = INERTIA_IDLE;
+        inertia_nudge_stop( si->hwnd );
+    }
+}
