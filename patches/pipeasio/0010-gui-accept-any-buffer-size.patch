+    /* Reject INI injection through discovered PipeWire names. The payload is
+     * a size both parsers accept, so only the newline rejection guards it. */
+    std::strcpy(c.output_device, "sink.test\nbuffer_size = 64");
     CHECK(!Config::save(c));
     CHECK(pipeasio_config_load(&d));
     CHECK(d.buffer_size == 2048);
@@ -540,6 +568,131 @@ test_dialog_loading_state()
     }
 }

+/* A stored size that is not a combo preset must be displayed as itself and
+ * survive open -> Apply unchanged. The old index-0 fallback displayed it as
+ * 16 (below the driver's floor) and Apply then wrote that 16 back. */
+static void
+test_buffer_size_dialog_roundtrip()
+{
+    pipeasio_config config = Config::defaults();
+    config.buffer_size     = 883;
+    CHECK(Config::save(config));
+
+    SettingsDialogOptions options;
+    options.monitorEnabled          = false;
+    options.deviceRequest.program   = QCoreApplication::applicationFilePath();
+    options.deviceRequest.arguments = { QStringLiteral("--devices") };
+    options.deviceRequest.timeoutMs = 1000;
+
+    SettingsDialog dialog(nullptr, options);
+    auto          *buffer = dialog.findChild<QComboBox *>(QStringLiteral("bufferSize"));
+    auto          *apply  = dialog.findChild<QPushButton *>(QStringLiteral("applyButton"));
+    CHECK(buffer != nullptr);
+    CHECK(apply != nullptr);
+    if (!buffer || !apply)
+        return;
+    CHECK(buffer->isEditable());
+    CHECK(buffer->findData(16) < 0); /* below the driver floor, not offered */
+    CHECK(buffer->currentText() == QStringLiteral("883"));
+
+    /* Open -> Apply, nothing touched: the file keeps 883 verbatim. */
+    apply->click();
+    CHECK(Config::load().buffer_size == 883);
+
+    /* A typed arbitrary size is saved verbatim and updates the latency
+     * readout (default rate 48000: 960 frames = 20.0 ms). */
+    auto *latency = dialog.findChild<QLabel *>(QStringLiteral("latency"));
+    CHECK(latency != nullptr);
+    buffer->setCurrentText(QStringLiteral("960"));
+    if (latency)
+        CHECK(latency->text() == QStringLiteral("20.0 ms"));
+    apply->click();
+    CHECK(Config::load().buffer_size == 960);
+
+    /* Leftover intermediate text (the validator allows "5" on the way to
+     * "512") must not silently replace a valid saved value with 1024. */
+    buffer->setCurrentText(QStringLiteral("5"));
+    apply->click();
+    CHECK(Config::load().buffer_size == 960);
+    auto *status = dialog.findChild<QLabel *>(QStringLiteral("saveStatus"));
+    CHECK(status != nullptr);
+    if (status)
+        CHECK(status->text().startsWith(QStringLiteral("Cannot save:")));
+
+    /* A preset keeps working through the data role. */
+    buffer->setCurrentIndex(buffer->findData(512));
+    apply->click();
+    CHECK(Config::load().buffer_size == 512);
+}
+
+static void
+test_channel_validation_and_save_feedback()
+{
+    CHECK(Config::save(Config::defaults()));
+    SettingsDialogOptions options;
+    options.monitorEnabled          = false;
+    options.deviceRequest.program   = QCoreApplication::applicationFilePath();
+    options.deviceRequest.arguments = { QStringLiteral("--devices") };
+    options.deviceRequest.timeoutMs = 1000;
+
+    SettingsDialog dialog(nullptr, options);
+    auto          *inputs  = dialog.findChild<QSpinBox *>(QStringLiteral("inputs"));
+    auto          *outputs = dialog.findChild<QSpinBox *>(QStringLiteral("outputs"));
+    auto          *apply   = dialog.findChild<QPushButton *>(QStringLiteral("applyButton"));
+    auto          *status  = dialog.findChild<QLabel *>(QStringLiteral("saveStatus"));
+    CHECK(inputs && outputs && apply && status);
+    if (!inputs || !outputs || !apply || !status)
+        return;
+
+    /* Either direction may be disabled independently. */
+    inputs->setValue(2);
+    outputs->setValue(0);
+    apply->click();
+    CHECK(Config::load().inputs == 2 && Config::load().outputs == 0);
+    CHECK(status->isVisibleTo(&dialog));
+    CHECK(status->text().contains(QStringLiteral("reselect PipeASIO")));
+
+    inputs->setValue(0);
+    outputs->setValue(2);
+    apply->click();
+    CHECK(Config::load().inputs == 0 && Config::load().outputs == 2);
+
+    /* The unusable 0/0 combination is rejected visibly and never written. */
+    inputs->setValue(0);
+    outputs->setValue(0);
+    apply->click();
+    CHECK(Config::load().inputs == 0 && Config::load().outputs == 2);
+    CHECK(status->text().startsWith(QStringLiteral("Cannot save:")));
+
+    /* I/O failures are not swallowed.  Point the config root at a regular
+     * file so mkpath/open must fail, then confirm both durable inline feedback
+     * and a nonblocking, parent-owned critical dialog. */
+    const QByteArray oldRoot = qgetenv("XDG_CONFIG_HOME");
+    QTemporaryDir    blocked;
+    CHECK(blocked.isValid());
+    const QString blocker = blocked.path() + QStringLiteral("/not-a-directory");
+    QFile         file(blocker);
+    CHECK(file.open(QIODevice::WriteOnly));
+    file.close();
+    qputenv("XDG_CONFIG_HOME", blocker.toUtf8());
+    inputs->setValue(1);
+    outputs->setValue(1);
+    apply->click();
+    CHECK(status->text().startsWith(QStringLiteral("Could not save settings")));
+    QApplication::processEvents();
+    auto *error = dialog.findChild<QMessageBox *>(QStringLiteral("saveErrorDialog"));
+    CHECK(error != nullptr);
+    if (error)
+    {
+        CHECK(error->icon() == QMessageBox::Critical);
+        CHECK(error->isVisible());
+        CHECK(error->text().contains(QStringLiteral("previous configuration is unchanged")));
+        error->done(QMessageBox::Ok);
+        QApplication::processEvents();
+    }
+    qputenv("XDG_CONFIG_HOME", oldRoot);
+}
