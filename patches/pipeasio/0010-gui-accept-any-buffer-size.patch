+/* The driver accepts any buffer size in [PIPEASIO_MIN_BUFFER_SIZE,
+ * PIPEASIO_MAX_BUFFER_SIZE], powers of two or not; the panel parser must
+ * agree, or opening and saving the panel destroys a config the driver runs
+ * happily. Out-of-range values fall back to the default, like the driver. */
+static void
+test_buffer_size_range()
+{
+    CHECK(Config::parseIni("buffer_size = 883").buffer_size == 883);
+    CHECK(Config::parseIni("buffer_size = 960").buffer_size == 960);
+    CHECK(Config::parseIni("buffer_size = 1000").buffer_size == 1000);
+    CHECK(Config::parseIni("buffer_size = 32").buffer_size == 32);
+    CHECK(Config::parseIni("buffer_size = 8192").buffer_size == 8192);
+
+    const int def = Config::defaults().buffer_size;
+    CHECK(Config::parseIni("buffer_size = 16").buffer_size == def);
+    CHECK(Config::parseIni("buffer_size = 31").buffer_size == def);
+    CHECK(Config::parseIni("buffer_size = 8193").buffer_size == def);
+
+    /* Serialization is verbatim: a non-power-of-two survives a round trip. */
+    pipeasio_config c = Config::defaults();
+    c.buffer_size     = 883;
+    CHECK(Config::parseIni(Config::serializeIni(c)).buffer_size == 883);
+}
