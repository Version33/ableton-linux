+/* The core info event lands during audio_open's initial sync. Log all three
+ * versions and fail closed against the same 1.4.2 support floor enforced by
+ * the installer; this also catches a post-install daemon downgrade. */
+static void
+audio_on_core_info(void *userdata, const struct pw_core_info *info)
+{
+    audio_client_t *c = userdata;
+    if (c->daemon_version_seen || !info || !info->version)
+        return;
+    c->daemon_version_seen = true;
+    c->daemon_supported = pipeasio_pipewire_version_supported(info->version);
+    TRACE("PipeWire daemon %s, client library %s, headers %s "
+          "(pipeasio-daemon-version)\n",
+          info->version, pw_get_library_version(), pw_get_headers_version());
+    if (!c->daemon_supported)
+        ERR("PipeWire daemon %s is unsupported; version "
+            PIPEASIO_PIPEWIRE_MIN_VERSION " or newer is required "
+            "(pipeasio-daemon-version)\n",
+            info->version);
+}
