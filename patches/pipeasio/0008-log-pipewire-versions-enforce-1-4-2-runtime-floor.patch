+/* PipeASIO 1.5's supported PipeWire client/daemon floor.  Keep this next to
+ * the pure parser so the runtime check and its native unit coverage share one
+ * fail-closed implementation. */
+#define PIPEASIO_PIPEWIRE_MIN_MAJOR 1
+#define PIPEASIO_PIPEWIRE_MIN_MINOR 4
+#define PIPEASIO_PIPEWIRE_MIN_PATCH 2
+#define PIPEASIO_PIPEWIRE_MIN_VERSION "1.4.2"
+
+static inline bool
+pipeasio_pipewire_version_supported(const char *text)
+{
+    const char   *part = text;
+    char         *end;
+    unsigned long values[3];
+    bool          prerelease = false;
+
+    if (!text || !*text)
+        return false;
+    for (size_t i = 0; i < 3; ++i)
+    {
+        if (*part < '0' || *part > '9')
+            return false;
+        errno     = 0;
+        values[i] = strtoul(part, &end, 10);
+        if (errno == ERANGE || end == part || end - part > 9 || values[i] > INT_MAX)
+            return false;
+        if (i < 2)
+        {
+            if (*end != '.')
+                return false;
+            part = end + 1;
+        }
+        else if (*end)
+        {
+            if (*end != '-' && *end != '+' && *end != '~')
+                return false;
+            prerelease = *end == '~';
+            const unsigned char *suffix = (const unsigned char *)end + 1;
+            if (!*suffix)
+                return false;
+            for (; *suffix; ++suffix)
+                if (!isalnum(*suffix) && *suffix != '.' && *suffix != '_'
+                    && *suffix != '~' && *suffix != '-')
+                    return false;
+        }
+    }
+
+    if (values[0] != PIPEASIO_PIPEWIRE_MIN_MAJOR)
+        return values[0] > PIPEASIO_PIPEWIRE_MIN_MAJOR;
+    if (values[1] != PIPEASIO_PIPEWIRE_MIN_MINOR)
+        return values[1] > PIPEASIO_PIPEWIRE_MIN_MINOR;
+    if (values[2] != PIPEASIO_PIPEWIRE_MIN_PATCH)
+        return values[2] > PIPEASIO_PIPEWIRE_MIN_PATCH;
+    return !prerelease;
+}
