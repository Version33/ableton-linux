@@ -1997,14 +2063,49 @@ audio_registry_property_valid(const char *value)
     return !value || strnlen(value, AUDIO_REGISTRY_PROPERTY_MAX + 1) <= AUDIO_REGISTRY_PROPERTY_MAX;
 }

+/* Keep the aggregate foreign-forcer count synchronized with the current
+ * property set of one bound node.  Registry globals only provide a creation
+ * snapshot; PW_NODE_CHANGE_MASK_PROPS is required for Q -> 0 and 0 -> Q on a
+ * node that stays alive. */
+static void
+audio_update_node_forcer(struct audio_node_info *node, const struct spa_dict *props)
+{
+    if (!node || node->is_ours || !node->client || !props)
+        return;
+    const char *force_q = spa_dict_lookup(props, PW_KEY_NODE_FORCE_QUANTUM);
+    if (!audio_registry_property_valid(force_q))
+        force_q = NULL;
+    int delta = pipeasio_quantum_forcer_transition(&node->foreign_forcer, force_q);
+    if (delta > 0)
+        atomic_fetch_add_explicit(&node->client->foreign_forcers, 1, memory_order_acq_rel);
+    else if (delta < 0)
+        atomic_fetch_sub_explicit(&node->client->foreign_forcers, 1, memory_order_acq_rel);
+    if (delta)
+        TRACE("registry: node %u force-quantum %s\n", node->id,
+              node->foreign_forcer ? "enabled" : "cleared");
+}
+
+static void
+audio_on_node_info(void *userdata, const struct pw_node_info *info)
+{
+    struct audio_node_info *node = userdata;
+    if (!info || !(info->change_mask & PW_NODE_CHANGE_MASK_PROPS))
+        return;
+    audio_update_node_forcer(node, info->props);
+}
