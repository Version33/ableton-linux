         }
     }
     method_end(&token);
@@ -2328,15 +2387,20 @@ apply_pending_config(IPipeASIOImpl *This)
         LONG use     = restore ? 0 : (adopt ? adopt : adopted);
-        if (use && !pipeasio_buffer_size_supported(use))
+        if (use && !advertisable_buffer_size(This, use))
             use = 0;
         This->host_current_buffersize
                 = use ? use
