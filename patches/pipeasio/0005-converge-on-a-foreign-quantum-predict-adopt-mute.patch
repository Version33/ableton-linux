+/* The quantum a global clock.force-quantum will actually give the graph:
+ * global settings metadata outranks every node request (issue #49).  The
+ * running clock.duration wins over the raw metadata value because the
+ * daemon clamps forced values to clock.quantum-limit, so metadata and
+ * reality can disagree (pipeasio-quantum-arbitration).  Returns 0 when no
+ * global force is set, or when the effective value is one CreateBuffers
+ * would reject: an invalid pin must never be advertised to the host. */
+static LONG
+effective_global_quantum(IPipeASIOImpl *This)
+{
+    if (!This->audio_client)
+        return 0;
+    LONG gq = (LONG)audio_global_force_quantum(This->audio_client);
+    if (gq <= 0)
+        return 0;
+    LONG eff = (LONG)audio_observed_quantum(This->audio_client);
+    LONG pin = eff ? eff : gq;
+    return pipeasio_buffer_size_supported(pin) ? pin : 0;
+}
