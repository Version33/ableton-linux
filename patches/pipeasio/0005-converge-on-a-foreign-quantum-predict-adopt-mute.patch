diff --git a/include/audio.h b/include/audio.h
index f1abc75..85def7a 100644
--- a/include/audio.h
+++ b/include/audio.h
@@ -112,10 +112,35 @@ void audio_set_follow_device(audio_client_t *client, bool follow);
 void audio_set_realtime(audio_client_t *client, bool realtime);

 /* Most recent graph quantum (clock.duration) the process callback observed
- * while following a device, or 0 if none seen yet. Lets the ASIO side settle
- * its buffer size to the device-dictated quantum. */
+ * during this activation, or 0 if none seen yet.  The raw duration is kept,
+ * including an unsupported value, so consumers can fail closed instead of
+ * mistaking an older valid duration for current graph reality.  Lets the ASIO
+ * side settle its buffer size to the device-dictated quantum in follow mode,
+ * adopt a foreign forced quantum
+ * outside it, and prefer graph reality over raw metadata (issue #49). */
 audio_nframes_t audio_observed_quantum(audio_client_t *client);

+/* Non-zero when the settings metadata carries a global clock.force-quantum;
+ * that value outranks every node request (issue #49).  The raw metadata
+ * value: the daemon may clamp it, so prefer audio_observed_quantum while
+ * the graph runs. */
+audio_nframes_t audio_global_force_quantum(audio_client_t *client);
+
+/* True while the graph quantum disagrees with the host buffer size and the
+ * mismatch fail-safe is armed: the ASIO side swaps silence both ways until
+ * the sizes converge (issue #49). */
+bool audio_quantum_muted(audio_client_t *client);
+
+/* True while a foreign quantum forcer is visible: a global
+ * clock.force-quantum in the settings metadata, or another node carrying a
+ * nonzero node.force-quantum.  Lets the watcher clear the adoption state
+ * when the forcing condition ends (issue #49). */
+bool audio_forcer_present(audio_client_t *client);
+
+/* Withdraw this node's forced-quantum request (write node.force-quantum 0)
+ * so the graph keeps the foreign quantum being adopted. */
+void audio_drop_force_quantum(audio_client_t *client);
+
 /* Nanosecond timestamp (PipeWire graph clock) of the most recent process cycle,
  * 0 before the first cycle. Feeds the ASIO host's systemTime. */
 uint64_t audio_get_time_nsec(audio_client_t *client);
diff --git a/include/pipeasio_parse.h b/include/pipeasio_parse.h
index e44668a..d2015e3 100644
--- a/include/pipeasio_parse.h
+++ b/include/pipeasio_parse.h
@@ -46,12 +46,74 @@ pipeasio_ascii_equal_ci(const char *left, const char *right)
     return !*left && !*right;
 }

+/* Update one cached node.force-quantum state from a complete PipeWire node
+ * property dictionary.  The return value is the delta for the aggregate
+ * foreign-forcer count: +1 for 0 -> Q, -1 for Q -> 0 (or absent/invalid),
+ * and 0 when the state did not change.  Keeping the transition in one pure
+ * helper makes dynamic property updates and the initial registry snapshot
+ * obey exactly the same rules. */
+static inline int
+pipeasio_quantum_forcer_transition(bool *forced, const char *value)
+{
+    int  parsed = 0;
+    bool next   = value && pipeasio_parse_int(value, 0, INT_MAX, &parsed) && parsed > 0;
+    if (!forced || next == *forced)
+        return 0;
+    *forced = next;
+    return next ? 1 : -1;
+}
+
+/* Commit a successful foreign-quantum rebuild.  A graph-wide force predicted
+ * before CreateBuffers has no pending reset target, so it must be recorded
+ * explicitly here or its later Q -> 0 transition cannot restore the user's
+ * configured preference.  A live global force outranks a stale node target. */
+static inline int
+pipeasio_quantum_commit_target(int buffer_size, int pending_quantum, int global_quantum)
+{
+    if (global_quantum > 0 && buffer_size == global_quantum)
+        return global_quantum;
+    if (pending_quantum > 0 && buffer_size == pending_quantum)
+        return pending_quantum;
+    return 0;
+}
+
+/* A reset request is only an attempt.  Retry the same restoration target after
+ * five seconds, while keeping the existing three-attempts-per-minute bound. */
+static inline bool
+pipeasio_quantum_retry_due(uint64_t last_request, uint64_t now, int attempts)
+{
+    return attempts < 3 && (!last_request || now - last_request >= 5000);
+}
+
+/* Commit restoration only after a successful CreateBuffers.  Fixed mode must
+ * land exactly on the configured target; host-controlled mode may choose any
+ * valid size after reading the post-adoption GetBufferSize contract.  A force
+ * that returned before the rebuild keeps restoration pending. */
+static inline int
+pipeasio_quantum_restore_after_create(int pending_target, bool fixed, int buffer_size,
+                                      bool foreign_forcer_present)
+{
+    if (pending_target <= 0 || foreign_forcer_present
+        || (fixed && buffer_size != pending_target))
+        return pending_target;
+    return 0;
+}
+
+static inline bool
+pipeasio_quantum_should_restore(int adopted_quantum, int pending_quantum, int observed_quantum,
+                                int host_quantum, bool foreign_forcer_present)
+{
+    return (adopted_quantum > 0 || pending_quantum > 0)
+           && (observed_quantum <= 0 || observed_quantum == host_quantum)
+           && !foreign_forcer_present;
+}
+
 static inline bool
 pipeasio_parse_bool(const char *text, bool *result)
 {
     const char *end;
     size_t      length;
-    char        value[8];
+    char        value[9];
     if (!text || !result)
         return false;
     while (isspace((unsigned char)*text))
@@ -65,16 +127,28 @@ pipeasio_parse_bool(const char *text, bool *result)
     memcpy(value, text, length);
     value[length] = '\0';
     if (!strcmp(value, "1") || pipeasio_ascii_equal_ci(value, "true")
-        || pipeasio_ascii_equal_ci(value, "on") || pipeasio_ascii_equal_ci(value, "yes"))
+        || pipeasio_ascii_equal_ci(value, "on") || pipeasio_ascii_equal_ci(value, "yes")
+        || pipeasio_ascii_equal_ci(value, "enabled"))
     {
         *result = true;
         return true;
     }
     if (!strcmp(value, "0") || pipeasio_ascii_equal_ci(value, "false")
-        || pipeasio_ascii_equal_ci(value, "off") || pipeasio_ascii_equal_ci(value, "no"))
+        || pipeasio_ascii_equal_ci(value, "off") || pipeasio_ascii_equal_ci(value, "no")
+        || pipeasio_ascii_equal_ci(value, "disabled"))
     {
         *result = false;
         return true;
     }
     return false;
 }
+
+/* Strict boolean toggle for PIPEASIO_* environment variables.  One parser
+ * serves the PE and Unix halves so case and token handling cannot diverge.
+ * Returns 1/0, or -1 when value is unset or not a recognised boolean. */
+static inline int
+pipeasio_env_bool(const char *value)
+{
+    bool result;
+    return pipeasio_parse_bool(value, &result) ? (result ? 1 : 0) : -1;
+}
