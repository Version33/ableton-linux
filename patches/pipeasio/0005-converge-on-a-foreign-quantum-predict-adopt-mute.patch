             {
+                if (quantum_policy_changed)
+                {
+                    /* An explicit user policy change supersedes any old
+                     * foreign-quantum target immediately. */
+                    atomic_store(&This->quantum_adopted, 0);
+                    atomic_store(&This->adopt_pending_quantum, 0);
+                    atomic_store(&This->adopt_request_tick, 0);
+                    atomic_store(&This->restore_pending_quantum, 0);
+                    atomic_store(&This->restore_request_tick, 0);
