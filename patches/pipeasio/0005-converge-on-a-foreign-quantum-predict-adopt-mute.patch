 static inline int sample_rate_callback(audio_nframes_t nframes, void *arg);
+static LONG restricted_buffer_size(IPipeASIOImpl *This, LONG frames, const char *what);

 /*
  *  Support functions
@@ -885,7 +899,10 @@ config_watch_proc(LPVOID arg)
 #else
     uint64_t last_fp = 0;
