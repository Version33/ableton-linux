+                /* A force returned before restoration was acknowledged.  Keep
+                 * the adopted size and cancel the obsolete restore target; a
+                 * new mismatch below begins a fresh adoption episode. */
+                atomic_store(&This->restore_pending_quantum, 0);
+                atomic_store(&This->restore_request_tick, 0);
+                /* Preserve restore_resets/restore_window: a flapping forcer
