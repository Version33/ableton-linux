+/* Graph-I/O actions for the optional WoW64 callback bridge.  Host callbacks
+ * still run at the cadence banked by audio_on_process while muted, but graph
+ * buffers must be neither read nor published; the backend owns the foreign-
+ * quantum buffers and publishes exactly one quantum of silence. */
+enum pipeasio_wow64_graph_action
+{
+    PIPEASIO_WOW64_READ_GRAPH    = 1u << 0,
+    PIPEASIO_WOW64_PUBLISH_GRAPH = 1u << 1
+};
+
+static inline uint32_t
+pipeasio_wow64_graph_actions(bool quantum_muted)
+{
+    return quantum_muted ? 0u : PIPEASIO_WOW64_READ_GRAPH | PIPEASIO_WOW64_PUBLISH_GRAPH;
+}
+
 #endif /* PIPEASIO_OFFSETS_H */
