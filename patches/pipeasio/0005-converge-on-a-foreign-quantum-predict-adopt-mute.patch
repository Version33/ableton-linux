+
+        /* Adopt (issue #49): outside follow mode a foreign forced quantum
+         * (a global clock.force-quantum, or another node's newer-stamped
+         * node.force-quantum) outranks this node's request, and the graph
+         * cycles at a size we did not ask for.  After two consecutive polls
+         * at the same foreign quantum, withdraw our force (write it once to
+         * 0, never re-assert mid-episode: only a value change wins
+         * arbitration, and re-forcing suspends every follower in the
+         * graph), record the target, and ask the host to rebuild at it.
+         * The target is committed only when the host's rebuild actually
+         * reaches CreateBuffers, so an ignored reset retries the same
+         * quantum; at most 3 adoptions a minute bound the loop.  The
+         * process path mutes while the sizes disagree, so until this
+         * converges the audible fault is silence plus a log line.
+         * PIPEASIO_ALLOW_QUANTUM_MISMATCH=on disables adoption and muting. */
+        if (!This->pipeasio_follow_device_clock && !This->pipeasio_allow_quantum_mismatch)
+        {
+            BOOL running = This->host_driver_state == Running;
+            LONG q = (LONG)audio_observed_quantum(This->audio_client);
+            LONG pending = atomic_load_explicit(&This->adopt_pending_quantum,
+                                                memory_order_acquire);
+            LONG adopted = atomic_load_explicit(&This->quantum_adopted,
+                                                memory_order_acquire);
+            LONG restore = atomic_load_explicit(&This->restore_pending_quantum,
+                                                memory_order_acquire);
+            bool forcing = audio_forcer_present(This->audio_client);
+            if (restore && forcing)
