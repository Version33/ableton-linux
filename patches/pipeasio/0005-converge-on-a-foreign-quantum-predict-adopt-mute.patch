         if (hint)
             This->host_current_buffersize = hint;
     }
+    /* Predict (issue #49): a global clock.force-quantum outranks every node
+     * request, so start from the size the graph will actually run. */
+    {
+        LONG gq = effective_global_quantum(This);
+        if (gq)
