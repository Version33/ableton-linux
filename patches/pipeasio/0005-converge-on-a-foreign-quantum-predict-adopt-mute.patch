                 EnterCriticalSection(&This->config_lock);
                 This->staged_cfg = newcfg;
                 LeaveCriticalSection(&This->config_lock);
@@ -1007,12 +1048,160 @@ config_watch_proc(LPVOID arg)
         if (This->pipeasio_follow_device_clock && This->host_driver_state == Running)
         {
             LONG q = (LONG)audio_observed_quantum(This->audio_client);
-            if (q && q != This->host_current_buffersize && q != last_reset_quantum)
+            if (q && !pipeasio_buffer_size_supported(q))
+                q = 0;
+            if (q && q != This->host_current_buffersize)
             {
-                atomic_store(&This->follower_quantum, q);
-                last_reset_quantum = q;
-                TRACE("config watcher: device quantum %ld, re-negotiating buffer\n", (long)q);
-                reset = true;
+                ULONGLONG now = GetTickCount64();
+                if (now - follow_window > 60000)
+                {
+                    follow_window = now;
+                    follow_resets = 0;
+                }
+                /* Do not commit the observed value as acknowledged merely
+                 * because a reset notification was sent.  Retry an ignored
+                 * request after five seconds, with the same per-minute bound
+                 * as foreign adoption. */
+                if ((follow_pending_quantum != q || !follow_request_tick
+                     || now - follow_request_tick >= 5000)
+                    && follow_resets < 3)
+                {
+                    atomic_store(&This->follower_quantum, q);
+                    follow_pending_quantum = q;
+                    follow_request_tick    = now;
+                    ++follow_resets;
+                    TRACE("config watcher: device quantum %ld, re-negotiating buffer "
+                          "(attempt %d this minute)\n",
+                          (long)q, follow_resets);
