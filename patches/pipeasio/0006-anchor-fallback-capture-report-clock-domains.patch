+++ b/tests/unit/test_config.c
@@ -201,6 +201,26 @@ main(void)
         EXPECT_EQ(pipeasio_quantum_commit_target(128, 256, 128), 128);
     }

+    TEST_GROUP("unset capture selection policy")
+    {
+        EXPECT_EQ(pipeasio_unset_capture_target(42, 7, 3), 42);
+        EXPECT_EQ(pipeasio_unset_capture_target(UINT32_MAX, 7, 3), 7);
+        EXPECT_EQ(pipeasio_unset_capture_target(UINT32_MAX, UINT32_MAX, 3), 3);
+        EXPECT_EQ(pipeasio_unset_capture_target(UINT32_MAX, UINT32_MAX, UINT32_MAX), UINT32_MAX);
+    }
+
+    TEST_GROUP("PipeWire object id parsing")
+    {
+        uint32_t id = UINT32_MAX;
+        EXPECT_TRUE(pipeasio_parse_u32_id(" 42 ", &id));
+        EXPECT_EQ(id, 42);
+        EXPECT_TRUE(!pipeasio_parse_u32_id("7x", &id));
+        EXPECT_TRUE(!pipeasio_parse_u32_id("-1", &id));
+        EXPECT_TRUE(!pipeasio_parse_u32_id("+1", &id));
+        EXPECT_TRUE(!pipeasio_parse_u32_id("4294967295", &id));
+        EXPECT_TRUE(!pipeasio_parse_u32_id("18446744073709551616", &id));
+    }
+
     /* Comments, stray whitespace, unknown keys, bool spellings, no header. */
     TEST_GROUP("lenient parse")
     {
