diff --git a/include/pipeasio_rt_priority.h b/include/pipeasio_rt_priority.h
index 996ca36..5436332 100644
--- a/include/pipeasio_rt_priority.h
+++ b/include/pipeasio_rt_priority.h
@@ -20,10 +20,13 @@
 /* Scheduling policy shared by the native and WoW64 callback threads. */
 #pragma once

+#include <sched.h>
 #include <stdbool.h>
 #include <stdlib.h>
 #include <string.h>

+#include "pipeasio_parse.h"
+
 /* Range accepted by PipeWire's thread-utils interface. */
 #define PIPEASIO_RT_PRIO_MIN 1
 #define PIPEASIO_RT_PRIO_MAX 80
@@ -40,10 +43,72 @@ pipeasio_rt_env_override(void)
     if (!env || !*env)
         return PIPEASIO_RT_ENV_UNSET;

-    if (!strcmp(env, "off") || !strcmp(env, "none") || !strcmp(env, "0"))
+    if (pipeasio_ascii_equal_ci(env, "off") || pipeasio_ascii_equal_ci(env, "none")
+        || !strcmp(env, "0"))
         return 0;
-    if (!strcmp(env, "on") || !strcmp(env, "default") || !strcmp(env, "1"))
+    if (pipeasio_ascii_equal_ci(env, "on") || pipeasio_ascii_equal_ci(env, "default")
+        || !strcmp(env, "1"))
         return 1;

     return PIPEASIO_RT_ENV_UNSET;
 }
+
+/* PIPEASIO_REALTIME: the plain boolean toggle for the data-loop scheduling
+ * class, parsed with the shared strict helper so every consumer agrees
+ * (pipeasio-honest-realtime).  Returns 1/0/-1 (unset or unrecognised).
+ * PIPEASIO_RT_PRIORITY above keeps the last word for compatibility. */
+static inline int
+pipeasio_realtime_env_override(void)
+{
+    return pipeasio_env_bool(getenv("PIPEASIO_REALTIME"));
+}
+
+/* Resolve the scheduling class once at the point of use.  The newer plain
+ * boolean overrides config.ini, while the legacy priority switch keeps the
+ * final word for compatibility. */
+static inline bool
+pipeasio_realtime_effective(bool configured)
+{
+    const int realtime_env = pipeasio_realtime_env_override();
+    if (realtime_env != -1)
+        configured = realtime_env != 0;
+
+    const int priority_env = pipeasio_rt_env_override();
+    if (priority_env != PIPEASIO_RT_ENV_UNSET)
+        configured = priority_env != 0;
+    return configured;
+}
+
+/* PipeWire discards acquire_rt's return value.  Validate the actual policy
+ * after pw_data_loop_start instead: realtime-on remains best effort, while
+ * realtime-off may activate only after reaching SCHED_OTHER 0. */
+static inline bool
+pipeasio_rt_start_allows_activation(bool realtime, int inspect_error, int policy, int priority)
+{
+    return realtime || (!inspect_error && policy == SCHED_OTHER && priority == 0);
+}
+
+/* Scheduling policy name for before/after logging. */
+static inline const char *
+pipeasio_sched_policy_name(int policy)
+{
+    switch (policy)
+    {
+    case SCHED_OTHER:
+        return "SCHED_OTHER";
+    case SCHED_FIFO:
+        return "SCHED_FIFO";
+    case SCHED_RR:
+        return "SCHED_RR";
+#ifdef SCHED_BATCH
+    case SCHED_BATCH:
+        return "SCHED_BATCH";
+#endif
+#ifdef SCHED_IDLE
+    case SCHED_IDLE:
+        return "SCHED_IDLE";
+#endif
+    default:
+        return "SCHED_?";
+    }
+}
diff --git a/src/asio.c b/src/asio.c
index 82db75d..610134c 100644
--- a/src/asio.c
+++ b/src/asio.c
@@ -3134,6 +3134,29 @@ configure_driver(IPipeASIOImpl *This)
                          sizeof(environment_variable)))
         This->pipeasio_allow_quantum_mismatch
                 = pipeasio_env_bool(environment_variable) == 1 ? TRUE : FALSE;
+    /* PIPEASIO_REALTIME toggles the data-loop scheduling class for one
+     * launch.  The backend reads the same variable at acquire time through
+     * the same strict parser, so the two halves cannot disagree
+     * (pipeasio-honest-realtime).  The shipped default stays realtime=off. */
+    if (read_environment("PIPEASIO_REALTIME", environment_variable,
+                         sizeof(environment_variable)))
+    {
+        switch (pipeasio_env_bool(environment_variable))
+        {
+        case 0:
+            This->pipeasio_realtime = FALSE;
+            break;
+        case 1:
+            This->pipeasio_realtime = TRUE;
+            break;
+        default:
+            WARN("PIPEASIO_REALTIME \"%s\" is not a recognised boolean "
+                 "(expected 1/0, true/false, yes/no, on/off, or enabled/disabled); "
+                 "keeping %s\n",
+                 environment_variable, This->pipeasio_realtime ? "on" : "off");
+            break;
+        }
+    }
     if (read_environment("PIPEASIO_PREFERRED_BUFFERSIZE", environment_variable,
                          sizeof(environment_variable)))
     {
diff --git a/src/audio.c b/src/audio.c
index 6221786..d57c661 100644
--- a/src/audio.c
+++ b/src/audio.c
@@ -93,7 +93,7 @@ struct audio_rt_state
     DWORD       win_tid;
     pthread_t   ptid;            /* captured inside the spawned thread */
     int         rt_priority;     /* current SCHED_FIFO priority, 0 = none */
-    bool        want_realtime;   /* from config.ini, PIPEASIO_RT_PRIORITY wins */
+    bool        want_realtime;   /* config value; environment resolved at start */
     atomic_bool ready;           /* released once ptid is captured */
     void *(*user_entry)(void *); /* PipeWire-provided entry */
     void *user_arg;
@@ -179,22 +179,58 @@ audio_rt_acquire(void *data, struct spa_thread *thread, int priority)
     struct audio_rt_state *s = data;
     (void)thread;

-    bool realtime = s->want_realtime;
-    switch (pipeasio_rt_env_override())
-    {
-    case 0:
-        realtime = false;
-        break;
-    case 1:
-        realtime = true;
-        break;
-    default:
-        break;
+    bool realtime = pipeasio_realtime_effective(s->want_realtime);
+
+    /* What the thread actually runs right now: under a launcher that starts
+     * the whole process realtime (chrt -r 10 wine), glibc's default
+     * PTHREAD_INHERIT_SCHED hands every created thread that class, so
+     * "realtime disabled" must actively demote, never just skip the raise
+     * (pipeasio-honest-realtime).  Both the before and after policies are
+     * logged. */
+    int                before_policy = -1;
+    struct sched_param before        = { 0 };
+    int inspect_err = pthread_getschedparam(s->ptid, &before_policy, &before);
+    if (inspect_err)
+    {
+        WARN("cannot inspect audio-thread scheduling before acquire: %s\n",
+             strerror(inspect_err));
+        return -1;
     }

     if (!realtime)
     {
-        TRACE("rt thread left SCHED_OTHER (realtime disabled)\n");
+        if (before_policy == SCHED_OTHER)
+        {
+            TRACE("rt thread stays SCHED_OTHER (realtime disabled, "
+                  "pipeasio-honest-realtime)\n");
+            s->rt_priority = 0;
+            return 0;
+        }
+        int err = pthread_setschedparam(s->ptid, SCHED_OTHER,
+                                        &(struct sched_param){ .sched_priority = 0 });
+        if (err)
+        {
+            WARN("realtime disabled, but the thread inherited %s %d and the demotion "
+                 "failed: %s (pipeasio-honest-realtime)\n",
+                 pipeasio_sched_policy_name(before_policy), before.sched_priority,
+                 strerror(err));
+            return -1;
+        }
+        int                after_policy = -1;
+        struct sched_param after        = { 0 };
+        err = pthread_getschedparam(s->ptid, &after_policy, &after);
+        if (err || after_policy != SCHED_OTHER || after.sched_priority != 0)
+        {
+            WARN("realtime-disabled audio-thread demotion did not reach SCHED_OTHER 0 "
+                 "(read=%s policy=%s priority=%d)\n",
+                 err ? strerror(err) : "ok", pipeasio_sched_policy_name(after_policy),
+                 after.sched_priority);
+            return -1;
+        }
+        TRACE("rt thread demoted %s %d -> SCHED_OTHER 0 (realtime disabled, "
+              "pipeasio-honest-realtime)\n",
+              pipeasio_sched_policy_name(before_policy), before.sched_priority);
+        s->rt_priority = 0;
         return 0;
     }

@@ -225,7 +261,9 @@ audio_rt_acquire(void *data, struct spa_thread *thread, int priority)
         return -1;
     }
     s->rt_priority = priority;
-    TRACE("rt thread acquired SCHED_FIFO %d\n", priority);
+    TRACE("rt thread acquired SCHED_FIFO %d (was %s %d)\n", priority,
+          before_policy < 0 ? "unreadable" : pipeasio_sched_policy_name(before_policy),
+          before.sched_priority);
     return 0;
 }

@@ -235,8 +273,22 @@ audio_rt_drop(void *data, struct spa_thread *thread)
     struct audio_rt_state *s = data;
     (void)thread;

-    if (!s->rt_priority)
+    /* Symmetric with acquire: read what the thread actually runs and demote
+     * whenever it is not SCHED_OTHER, even when the raise was never ours
+     * (launcher inheritance, pipeasio-honest-realtime). */
+    int                policy  = -1;
+    struct sched_param current = { 0 };
+    int inspect_err = pthread_getschedparam(s->ptid, &policy, &current);
+    if (inspect_err)
+    {
+        WARN("cannot inspect audio-thread scheduling before drop: %s\n", strerror(inspect_err));
+        return -1;
+    }
+    if (policy == SCHED_OTHER)
+    {
+        s->rt_priority = 0;
         return 0;
+    }

     int err = pthread_setschedparam(s->ptid, SCHED_OTHER,
                                     &(struct sched_param){ .sched_priority = 0 });
@@ -245,6 +297,18 @@ audio_rt_drop(void *data, struct spa_thread *thread)
         WARN("pthread_setschedparam(SCHED_OTHER) failed: %s\n", strerror(err));
         return -1;
     }
+    struct sched_param after = { 0 };
+    int after_policy = -1;
+    err = pthread_getschedparam(s->ptid, &after_policy, &after);
+    if (err || after_policy != SCHED_OTHER || after.sched_priority != 0)
+    {
+        WARN("audio-thread drop did not reach SCHED_OTHER 0 (read=%s policy=%s priority=%d)\n",
+             err ? strerror(err) : "ok", pipeasio_sched_policy_name(after_policy),
+             after.sched_priority);
+        return -1;
+    }
+    TRACE("rt thread dropped %s %d -> SCHED_OTHER 0 (pipeasio-honest-realtime)\n",
+          pipeasio_sched_policy_name(policy), current.sched_priority);
     s->rt_priority = 0;
     return 0;
 }
@@ -928,7 +992,11 @@ audio_activate(audio_client_t *c)
     pw_thread_loop_unlock(c->loop);

     /* Start the data loop after add_port/connect; those need the thread-loop
-     * context while the data loop is stopped. */
+     * context while the data loop is stopped.  PipeWire ignores acquire_rt's
+     * return, so verify the actual policy after start instead. */
+#ifndef PIPEASIO_AUDIO_UNIXLIB
+    bool require_other = !pipeasio_realtime_effective(c->rt.want_realtime);
+#endif
     pw_thread_loop_lock(c->loop);
     if (pw_data_loop_start(c->data_loop) < 0)
     {
@@ -936,6 +1004,21 @@ audio_activate(audio_client_t *c)
         ERR("pw_data_loop_start failed\n");
         goto fail;
     }
+#ifndef PIPEASIO_AUDIO_UNIXLIB
+    int                policy = -1;
+    struct sched_param actual = { 0 };
+    int inspect_err = require_other ? pthread_getschedparam(c->rt.ptid, &policy, &actual) : 0;
+    if (!pipeasio_rt_start_allows_activation(!require_other, inspect_err, policy,
+                                             actual.sched_priority))
+    {
+        pw_thread_loop_unlock(c->loop);
+        ERR("audio_activate: realtime-off scheduling normalization failed "
+            "(read=%s policy=%s priority=%d)\n",
+            inspect_err ? strerror(inspect_err) : "ok", pipeasio_sched_policy_name(policy),
+            actual.sched_priority);
+        goto fail;
+    }
+#endif
     pw_thread_loop_unlock(c->loop);

     /* Wait until the async pw_filter_connect bind publishes a node id. */
diff --git a/src/wow64/audio_unix.c b/src/wow64/audio_unix.c
index fce5c79..2f7a7bc 100644
--- a/src/wow64/audio_unix.c
+++ b/src/wow64/audio_unix.c
@@ -31,6 +31,7 @@
 #include <sched.h>
 #include <stdbool.h>
 #include <stdint.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
@@ -964,16 +965,49 @@ wow64_wait_callback(void *args)

     if (!cc->rt_raised)
     {
-        cc->rt_raised      = true; /* one attempt per pump-thread lifetime */
-        bool      realtime = cc->want_realtime;
-        const int env      = pipeasio_rt_env_override();
-        if (env != PIPEASIO_RT_ENV_UNSET)
-            realtime = (env != 0);
+        bool realtime = pipeasio_realtime_effective(cc->want_realtime);
+        int                policy  = -1;
+        struct sched_param current = { 0 };
+        int sched_err = pthread_getschedparam(pthread_self(), &policy, &current);
+        if (sched_err)
+        {
+            fprintf(stderr, "pipeasio: cannot inspect WoW64 pump scheduling: %s\n",
+                    strerror(sched_err));
+            return STATUS_UNSUCCESSFUL;
+        }
         if (realtime)
             pthread_setschedparam(pthread_self(), SCHED_FIFO,
                                   &(struct sched_param){ .sched_priority = PAU_PUMP_RT_PRIORITY });
-        /* best-effort: EPERM (no RLIMIT_RTPRIO / not in audio group) leaves
-         * the pump at SCHED_OTHER, still functional. */
+        else if (policy != SCHED_OTHER)
+        {
+            /* The pump inherited a realtime class from the launcher
+             * (PTHREAD_INHERIT_SCHED); realtime off must actively demote,
+             * not just skip the raise (pipeasio-honest-realtime). */
+            sched_err = pthread_setschedparam(pthread_self(), SCHED_OTHER,
+                                              &(struct sched_param){ .sched_priority = 0 });
+            if (sched_err)
+            {
+                fprintf(stderr,
+                        "pipeasio: cannot demote WoW64 pump from %s %d to SCHED_OTHER: %s\n",
+                        pipeasio_sched_policy_name(policy), current.sched_priority,
+                        strerror(sched_err));
+                return STATUS_UNSUCCESSFUL;
+            }
+            sched_err = pthread_getschedparam(pthread_self(), &policy, &current);
+            if (sched_err || policy != SCHED_OTHER || current.sched_priority != 0)
+            {
+                fprintf(stderr,
+                        "pipeasio: WoW64 pump demotion did not reach SCHED_OTHER 0 "
+                        "(read=%s policy=%s priority=%d)\n",
+                        sched_err ? strerror(sched_err) : "ok",
+                        pipeasio_sched_policy_name(policy), current.sched_priority);
+                return STATUS_UNSUCCESSFUL;
+            }
+        }
+        cc->rt_raised = true; /* one successful policy decision per pump lifetime */
+        /* The realtime raise remains best-effort (EPERM leaves the pump at
+         * its prior class).  Realtime-off demotion above is mandatory and
+         * verified because inherited RR is precisely what off must prevent. */
     }

     pthread_mutex_lock(&cc->mutex);
