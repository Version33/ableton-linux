From fea78eb99a68e0efd64733b3b81cd8f3616d4dcc Mon Sep 17 00:00:00 2001
From: Shibco <cade@parare.al>
Date: Sun, 9 Aug 2026 01:50:53 +0200
Subject: [PATCH 2/7] asio: report timeGetTime in ASIO systemTime

Live timestamps incoming MIDI with timeGetTime and windows them against
systemTime; the graph-clock origin made every live-played note miss the
window (issue 19 in the ableton-linux tracker). WineASIO reported
timeGetTime; do the same.

timeGetTime is a 32-bit millisecond counter over the host's
CLOCK_BOOTTIME and wraps every 49.71 days of host uptime. Keep a 64-bit
extension in the driver (last raw reading plus accumulated rollovers,
monotonic) and scale that to the ASIO nanosecond domain, so the MIDI
window survives a wrap on long-uptime machines.
---
 src/asio.c | 32 +++++++++++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/src/asio.c b/src/asio.c
index 423483f..ba791e7 100644
--- a/src/asio.c
+++ b/src/asio.c
@@ -308,6 +308,10 @@ typedef struct IPipeASIOImpl
     TimeInformation  host_time;
     BOOL             host_time_info_mode;
     _Atomic uint64_t host_time_stamp;
+    /* 64-bit extension of the 32-bit timeGetTime counter feeding systemTime
+     * (pipeasio-midi-timebase).  Written only on the process path. */
+    DWORD    host_tgt_last_ms;
+    uint64_t host_tgt_high_ms;
     LONG             host_version;
     /* Rate the host asked for through SetSampleRate, 0 = none.  Applied on the
      * next activation when config.ini does not pin a rate of its own. */
@@ -739,14 +743,35 @@ pipeasio_host_call_process(pipeasio_host_call_token *token, int32_t buffer_index
     Callbacks     *cb      = token->callbacks;
     uint64_t       samples = atomic_load_explicit(&This->host_num_samples, memory_order_relaxed);
 
-    atomic_store_explicit(&This->host_time_stamp, time_nsec, memory_order_relaxed);
+    /* Live timestamps incoming MIDI with timeGetTime and compares those
+     * stamps against systemTime.  The PipeWire graph clock has a different
+     * origin, so every live-played event is dropped as out of window.
+     * Report timeGetTime, as WineASIO did (pipeasio-midi-timebase).
+     *
+     * timeGetTime is a 32-bit millisecond counter over the host's
+     * CLOCK_BOOTTIME: it wraps every 49.71 days of host uptime, regardless
+     * of when the host application launched.  Extend it to 64 bits before
+     * scaling to the ASIO nanosecond domain: remember the last raw reading
+     * and accumulate a rollover whenever the counter goes backwards (the
+     * raw counter is monotonic, so a smaller reading can only be a wrap).
+     * Only this process path touches the extension state.  One wrap
+     * between two consecutive readings is the covered case; the stream
+     * would have to sit stopped across 49.7 days to miss one. */
+    DWORD now_ms = timeGetTime();
+    if (now_ms < This->host_tgt_last_ms)
+        This->host_tgt_high_ms += (uint64_t)1 << 32;
+    This->host_tgt_last_ms = now_ms;
+    uint64_t sys_nsec      = (This->host_tgt_high_ms + now_ms) * 1000000u;
+    (void)time_nsec;
+
+    atomic_store_explicit(&This->host_time_stamp, sys_nsec, memory_order_relaxed);
     if (This->host_time_info_mode)
     {
         This->host_time._2            = 1.0;
         This->host_time.numSamples.lo = (ULONG)(samples & 0xFFFFFFFFu);
         This->host_time.numSamples.hi = (ULONG)(samples >> 32);
-        This->host_time.timeStamp.lo  = (ULONG)(time_nsec & 0xFFFFFFFFu);
-        This->host_time.timeStamp.hi  = (ULONG)(time_nsec >> 32);
+        This->host_time.timeStamp.lo  = (ULONG)(sys_nsec & 0xFFFFFFFFu);
+        This->host_time.timeStamp.hi  = (ULONG)(sys_nsec >> 32);
         This->host_time.sampleRate
                 = (double)atomic_load_explicit(&This->host_sample_rate, memory_order_acquire);
         This->host_time.flags = 0x7;
@@ -1505,6 +1530,7 @@ Start(LPPIPEASIO iface)
     This->host_buffer_index = 0;
     atomic_store_explicit(&This->host_num_samples, 0, memory_order_relaxed);
     atomic_store_explicit(&This->host_time_stamp, 0, memory_order_relaxed);
+    TRACE("ASIO systemTime uses the timeGetTime timebase (pipeasio-midi-timebase)\n");
 #ifdef PIPEASIO_WOW64_PE
     {
         bool in_active[PIPEASIO_MAX_CHANNELS]  = { false };
-- 
2.55.0

