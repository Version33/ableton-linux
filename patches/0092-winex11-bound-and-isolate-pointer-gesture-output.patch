+/* Middle-drag navigation withholds its button press from the application.
+ * Still invalidate fixed wheel messages queued before that physical press. */
+static void notify_button_transition( HWND hwnd, unsigned int button, BOOL down )
+{
+    SERVER_START_REQ( update_driver_button )
+    {
+        req->win = wine_server_user_handle( hwnd );
+        req->button = button;
+        req->state = pinch_button_is_wheel( button ) ? -1 : down;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+}
