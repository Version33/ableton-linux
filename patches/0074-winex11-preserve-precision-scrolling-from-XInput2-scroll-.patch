+#ifdef XIScrollClass
+
+/***********************************************************************
+ *           smooth_scroll_delta
+ *
+ * Convert a cumulative scroll valuator report into wheel units. The
+ * baseline advances by exactly what was reported, so the sub-unit rest
+ * carries into the next report. A report beyond the per-report cap
+ * advances the baseline all the way and discards the excess: no debt
+ * survives to burst into a later report. A jump beyond any plausible
+ * single report is a discontinuity the invalidation hooks missed (the
+ * server may also legally reset a cumulative valuator), and reseeds
+ * instead of scrolling.
+ */
+static int smooth_scroll_delta( struct x11drv_scroll_axis *axis, double value, BOOL emulated )
+{
+    static const int max_delta = 16 * WHEEL_DELTA;
+    double units;
+    int delta;
+
+    if (!axis->value_valid || emulated)
+    {
+        axis->value = value;
+        axis->value_valid = TRUE;
+        return 0;
+    }
+
+    units = WHEEL_DELTA * (value - axis->value) / axis->increment;
+
+    if (fabs( units ) > 2.0 * max_delta)
+    {
+        axis->value = value;
+        return 0;
+    }
+
+    if ((delta = round( units )) > max_delta || delta < -max_delta)
+    {
+        axis->value = value;
+        return delta > 0 ? max_delta : -max_delta;
+    }
+
+    if (pointer_config.smooth_scrolling == POINTER_SCROLL_NOTCHED)
+        delta = (delta / WHEEL_DELTA) * WHEEL_DELTA;
+    axis->value += (double)delta * axis->increment / WHEEL_DELTA;
+    return delta;
+}
+
+static unsigned int xinput2_core_state( const XIDeviceEvent *event )
+{
+    unsigned int state = event->mods.effective;
+    int button;
+
+    /* XIButtonState uses button numbers as bit indices.  Core X state only
+     * has masks for the first five buttons, which is all the existing core
+     * handlers inspect. */
+    for (button = 1; button <= 5; button++)
+        if (button / 8 < event->buttons.mask_len && XIMaskIsSet( event->buttons.mask, button ))
+            state |= Button1Mask << (button - 1);
+    return state;
+}
+
+/***********************************************************************
+ *           forward_xinput2_core_event
+ *
+ * Selecting a master-device XI event prevents the X server from delivering
+ * its core equivalent.  Feed non-scroll button events and motion through
+ * Wine's existing core handlers so smooth scrolling does not replace normal
+ * pointer input.
+ */
+static BOOL forward_xinput2_core_event( HWND hwnd, XIDeviceEvent *event )
+{
+    XEvent core = {0};
+
+    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
+    {
+        core.xbutton.type = event->evtype == XI_ButtonPress ? ButtonPress : ButtonRelease;
+        core.xbutton.serial = event->serial;
+        core.xbutton.send_event = event->send_event;
+        core.xbutton.display = event->display;
+        core.xbutton.window = event->event;
+        core.xbutton.root = event->root;
+        core.xbutton.subwindow = event->child;
+        core.xbutton.time = event->time;
+        core.xbutton.x = event->event_x;
+        core.xbutton.y = event->event_y;
+        core.xbutton.x_root = event->root_x;
+        core.xbutton.y_root = event->root_y;
+        core.xbutton.state = xinput2_core_state( event );
+        core.xbutton.button = event->detail;
+        core.xbutton.same_screen = True;
+        if (event->evtype == XI_ButtonPress) return X11DRV_ButtonPress( hwnd, &core );
+        return X11DRV_ButtonRelease( hwnd, &core );
+    }
+
+    core.xmotion.type = MotionNotify;
+    core.xmotion.serial = event->serial;
+    core.xmotion.send_event = event->send_event;
+    core.xmotion.display = event->display;
+    core.xmotion.window = event->event;
+    core.xmotion.root = event->root;
+    core.xmotion.subwindow = event->child;
+    core.xmotion.time = event->time;
+    core.xmotion.x = event->event_x;
+    core.xmotion.y = event->event_y;
+    core.xmotion.x_root = event->root_x;
+    core.xmotion.y_root = event->root_y;
+    core.xmotion.state = xinput2_core_state( event );
+    core.xmotion.is_hint = NotifyNormal;
+    core.xmotion.same_screen = True;
+    return X11DRV_MotionNotify( hwnd, &core );
+}
+
+/* latest value of each scroll axis in one event, and whether it carries motion */
+static void scan_scroll_valuators( XIDeviceEvent *event, struct x11drv_scroll_source *src,
+                                   double *value_x, double *value_y, BOOL *have_x, BOOL *have_y,
+                                   BOOL *saw_motion )
+{
+    const double *values = event->valuators.values;
+    int i;
+
+    for (i = 0; i < event->valuators.mask_len * 8; i++)
+    {
+        if (!XIMaskIsSet( event->valuators.mask, i )) continue;
+        if (i == src->scroll_x.number) { *value_x = *values; *have_x = TRUE; }
+        else if (i == src->scroll_y.number) { *value_y = *values; *have_y = TRUE; }
+        else if (i < 2) *saw_motion = TRUE;  /* valuators 0 and 1 are the pointer */
+        values++;
+    }
+}
+
+/***********************************************************************
+ *           X11DRV_SmoothScrollEvent
+ *
+ * XInput2 reports touchpad and high-resolution wheel scrolling as cumulative
+ * valuator positions. Turn the change into fractional Win32 wheel units and
+ * ignore the legacy button events the X server emulates from the same input.
+ *
+ * The wheel input carries no position: the server stamps each message at
+ * the current cursor, which is where X delivered the event. Scrolling is
+ * delivered whether or not a button is held; WM_MOUSEWHEEL defines
+ * MK_LBUTTON and friends as ordinary message states, and dropping input
+ * because of them would lose high-resolution wheel movement during drags.
+ */
+static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
+{
+    XIDeviceEvent *event = xev->data;
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_source *src;
+    struct x11drv_win_data *win_data;
+    UINT time = EVENT_x11_time_to_win32_time( event->time );
+    BOOL emulated = event->flags & XIPointerEmulated;
+    double value_x = 0, value_y = 0;
+    BOOL have_x = FALSE, have_y = FALSE, saw_motion = FALSE;
+    int delta_x = 0, delta_y = 0;
+    HWND hwnd;
+
+    if (!xinput2_smooth_scroll) return FALSE;
+    if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+
+    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
+    {
+        int button = event->detail - 1;
+
+        if (button < 3 || button > 6) return forward_xinput2_core_event( hwnd, event );
+        if (event->evtype == XI_ButtonRelease || emulated) return TRUE;
+
+        /* a native XI wheel button: a device without scroll axes reporting a
+         * whole notch per press */
+        if ((win_data = get_win_data( hwnd )))
+        {
+            /* user-time feeds focus-stealing arbitration only; pushing the
+             * property for every report of a scroll stream wakes the X
+             * server hundreds of times a second for nothing */
+            if ((Time)(event->time - win_data->user_time) >= 100)
+                window_set_user_time( win_data, event->time, FALSE );
+            release_win_data( win_data );
+        }
+        send_wheel_only_input( hwnd, button_down_flags[button], (int)button_down_data[button], time );
+        return TRUE;
+    }
+
+    if (!(src = find_scroll_source( data, event->sourceid, FALSE )))
+    {
+        /* a device that appeared after the init-time pre-scan is queried
+         * once, when first seen; its axes and baselines stay cached */
+        query_scroll_valuators( event->display, event->sourceid );
+        if (!(src = find_scroll_source( data, event->sourceid, FALSE )))
+            return forward_xinput2_core_event( hwnd, event );
+    }
+    src->time = event->time;
+
+    scan_scroll_valuators( event, src, &value_x, &value_y, &have_x, &have_y, &saw_motion );
+    if (!have_x && !have_y) return forward_xinput2_core_event( hwnd, event );
+
+    if (emulated)
+    {
+        /* the emulated report only refreshes the baseline; the same movement
+         * arrives as core wheel buttons */
+        if (have_x) smooth_scroll_delta( &src->scroll_x, value_x, TRUE );
+        if (have_y) smooth_scroll_delta( &src->scroll_y, value_y, TRUE );
+        return TRUE;
+    }
+
+    if (have_x) delta_x = smooth_scroll_delta( &src->scroll_x, value_x, FALSE );
+    if (have_y) delta_y = smooth_scroll_delta( &src->scroll_y, value_y, FALSE );
+
+    TRACE( "hwnd %p/%lx smooth scroll delta %d,%d\n", hwnd, event->event, delta_x, delta_y );
+
+    if (delta_x || delta_y)
+    {
+        if ((win_data = get_win_data( hwnd )))
+        {
+            /* throttled: the property write wakes the X server and the
+             * window manager, and a scroll stream reports ~250 times a
+             * second. once per 100 ms keeps user activity current */
+            if ((Time)(event->time - win_data->user_time) >= 100)
+                window_set_user_time( win_data, event->time, FALSE );
+            release_win_data( win_data );
+        }
+        if (delta_y) send_wheel_only_input( hwnd, MOUSEEVENTF_WHEEL, -delta_y, time );
+        if (delta_x) send_wheel_only_input( hwnd, MOUSEEVENTF_HWHEEL, delta_x, time );
+    }
+
+    /* a report can carry pointer motion next to the scroll axes */
+    if (saw_motion) forward_xinput2_core_event( hwnd, event );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           X11DRV_HierarchyChanged
+ *
+ * XInput2 reuses device IDs after removal. Dropping the cache entry of a
+ * removed device keeps a stale entry from describing whatever device is
+ * assigned the ID next.
+ */
+static BOOL X11DRV_HierarchyChanged( XGenericEventCookie *xev )
+{
+    XIHierarchyEvent *event = xev->data;
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_source *src;
+    int i;
+
+    if (!(event->flags & (XISlaveRemoved | XIDeviceDisabled))) return TRUE;
+    for (i = 0; i < event->num_info; i++)
+    {
+        if (!(event->info[i].flags & (XISlaveRemoved | XIDeviceDisabled))) continue;
+        if ((src = find_scroll_source( data, event->info[i].deviceid, FALSE )))
+        {
+            TRACE( "scroll source %d removed\n", src->sourceid );
+            src->sourceid = 0;
+        }
+#ifdef XI_GesturePinchBegin
+        {
+            struct x11drv_pinch_gesture *gesture;
+            int j;
+
+            for (j = 0; j < POINTER_PINCH_SLOTS; j++)
+            {
+                gesture = &data->pinch_gestures[j];
+                if (gesture->sourceid != event->info[i].deviceid) continue;
+                pinch_release_control( gesture, data->display );
+                gesture->sourceid = 0;
+            }
+        }
+#endif
+    }
+    return TRUE;
+}
