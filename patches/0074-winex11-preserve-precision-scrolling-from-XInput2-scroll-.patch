+#ifdef XIScrollClass
+static BOOL xinput2_smooth_scroll;
+
+/***********************************************************************
+ *              find_scroll_source
+ *
+ * Look up the scroll axes of a slave device. Each device keeps its own
+ * axis metadata and cumulative baselines, so alternating between a mouse
+ * and a touchpad neither re-queries the device nor discards the first
+ * movement after the switch. A full cache evicts the device that reported
+ * longest ago, never a fixed slot.
+ */
+static struct x11drv_scroll_source *find_scroll_source( struct x11drv_thread_data *data,
+                                                        int sourceid, BOOL create )
+{
+    struct x11drv_scroll_source *src, *free_slot = NULL, *oldest = NULL;
+    int i;
+
+    for (i = 0; i < SCROLL_SOURCE_CACHE_SIZE; i++)
+    {
+        src = &data->scroll_sources[i];
+        if (src->sourceid == sourceid) return src;
+        if (!src->sourceid) { if (!free_slot) free_slot = src; }
+        else if (!oldest || src->time < oldest->time) oldest = src;
+    }
+    if (!create) return NULL;
+    if (!free_slot)
+    {
+        TRACE( "evicting scroll source %d\n", oldest->sourceid );
+        free_slot = oldest;
+    }
+    memset( free_slot, 0, sizeof(*free_slot) );
+    free_slot->sourceid = sourceid;
+    free_slot->scroll_x.number = free_slot->scroll_y.number = -1;
+    return free_slot;
+}
+
+/***********************************************************************
+ *              pointer_scroll_invalidate_baselines
+ *
+ * Drop every cached cumulative baseline. XInput2 scroll valuators advance
+ * whenever the device scrolls anywhere: another application, another Wine
+ * thread's window, a grab. After any discontinuity in what this thread
+ * observed, the next report reseeds each baseline and reports no movement,
+ * instead of delivering the whole missed distance as one burst.
+ */
+void pointer_scroll_invalidate_baselines(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    int i;
+
+    if (!data) return;
+    for (i = 0; i < SCROLL_SOURCE_CACHE_SIZE; i++)
+    {
+        data->scroll_sources[i].scroll_x.value_valid = FALSE;
+        data->scroll_sources[i].scroll_y.value_valid = FALSE;
+    }
+}
+
+/***********************************************************************
+ *              update_scroll_valuators
+ */
+static void update_scroll_valuators( XIAnyClassInfo **classes, int num_classes, int sourceid )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_source *src;
+    struct x11drv_scroll_axis *axis;
+    int i;
+
+    if (!sourceid)  /* caller does not know the source, take it from the class */
+    {
+        for (i = 0; i < num_classes; i++)
+            if (classes[i]->type == XIScrollClass)
+            {
+                sourceid = ((XIScrollClassInfo *)classes[i])->sourceid;
+                break;
+            }
+    }
+    if (!sourceid) return;
+    if (!(src = find_scroll_source( data, sourceid, TRUE ))) return;
+
+    /* the device changed: its axes and their cumulative baselines restart */
+    src->scroll_x.number = src->scroll_y.number = -1;
+    src->scroll_x.value_valid = src->scroll_y.value_valid = FALSE;
+
+    for (i = 0; i < num_classes; i++)
+    {
+        XIScrollClassInfo *scroll;
+
+        if (classes[i]->type != XIScrollClass) continue;
+        scroll = (XIScrollClassInfo *)classes[i];
+        if (!scroll->increment) continue;
+        if (scroll->sourceid != sourceid) continue;
+
+        if (scroll->scroll_type == XIScrollTypeVertical) axis = &src->scroll_y;
+        else if (scroll->scroll_type == XIScrollTypeHorizontal) axis = &src->scroll_x;
+        else continue;
+        if (axis->number >= 0 && !(scroll->flags & XIScrollFlagPreferred)) continue;
+        axis->number = scroll->number;
+        axis->increment = scroll->increment;
+    }
+
+    TRACE( "source %d scroll x %d/%f, y %d/%f\n", src->sourceid,
+           src->scroll_x.number, src->scroll_x.increment,
+           src->scroll_y.number, src->scroll_y.increment );
+}
+
+static void query_scroll_valuators( Display *display, int sourceid )
+{
+    XIDeviceInfo *info;
+    int count;
+
+    if ((info = pXIQueryDevice( display, sourceid, &count )))
+    {
+        update_scroll_valuators( info->classes, info->num_classes, sourceid );
+        pXIFreeDeviceInfo( info );
+    }
+    else update_scroll_valuators( NULL, 0, sourceid );
+}
+
+/***********************************************************************
+ *              prescan_scroll_devices
+ *
+ * Query every slave device's scroll classes once at thread init, so the
+ * first scroll report of a session pays no XIQueryDevice round trip.
+ * Devices that appear later are queried on their first report.
+ */
+static void prescan_scroll_devices( Display *display )
+{
+    XIDeviceInfo *info;
+    int i, count;
+
+    if (!(info = pXIQueryDevice( display, XIAllDevices, &count ))) return;
+    for (i = 0; i < count; i++)
+    {
+        int j;
+
+        if (info[i].use != XISlavePointer && info[i].use != XIFloatingSlave) continue;
+        for (j = 0; j < info[i].num_classes; j++)
+            if (info[i].classes[j]->type == XIScrollClass)
+            {
+                update_scroll_valuators( info[i].classes, info[i].num_classes, info[i].deviceid );
+                break;
+            }
+    }
+    pXIFreeDeviceInfo( info );
+}
+#else
+
+void pointer_scroll_invalidate_baselines(void)
+{
+}
+#endif /* XIScrollClass */
+
 
