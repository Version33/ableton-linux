+/***********************************************************************
+ *           send_wheel_at_input
+ *
+ * Send wheel input at a stored point without moving the desktop cursor.
+ */
+static void send_wheel_at_input( HWND hwnd, POINT point, UINT flags, int delta, UINT time )
+{
+    INPUT input = { .type = INPUT_MOUSE };
+
+    input.mi.dx = point.x;
+    input.mi.dy = point.y;
+    input.mi.dwFlags = flags;
+    input.mi.mouseData = delta;
+    input.mi.time = time;
+
+    NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT | SEND_HWMSG_FIXED_POSITION, &input, 0 );
+}
+
+static BOOL pointer_button_down(void)
+{
+    return (NtUserGetKeyState( VK_LBUTTON ) | NtUserGetKeyState( VK_MBUTTON ) |
+            NtUserGetKeyState( VK_RBUTTON ) | NtUserGetKeyState( VK_XBUTTON1 ) |
+            NtUserGetKeyState( VK_XBUTTON2 )) & 0x8000;
+}
+
+/***********************************************************************
+ *           send_wheel_control_input
+ *
+ * Send a wheel-only event whose message reports MK_CONTROL. No key input
+ * exists. SEND_HWMSG_FORCE_MK_CONTROL makes the server set the modifier in
+ * this message's wparam only. The helper changes no key state, and it does
+ * not affect a Ctrl that the user physically holds.
+ * The call therefore needs no key-state restoration.
+ */
+static void send_wheel_control_input( HWND hwnd, int delta, UINT time )
+{
+    INPUT input = { .type = INPUT_MOUSE };
+
+    input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+    input.mi.mouseData = delta;
+    input.mi.time = time;
+
+    NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT | SEND_HWMSG_FORCE_MK_CONTROL, &input, 0 );
+}
+
 /* movement one wheel notch stands for, in raw virtual screen pixels */
 #define MIDDLE_DRAG_STEP 24
 
