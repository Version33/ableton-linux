+#ifdef XI_GesturePinchBegin
+
+/***********************************************************************
+ *           set_control_key_state
+ *
+ * Hold or release Ctrl in the calling thread's queue key state and the
+ * async key state, without generating any key input. GetKeyState() and
+ * GetAsyncKeyState() then report the modifier while no key message, hook
+ * event or accelerator fires. Some applications read the key state rather
+ * than the wheel message, so both views report Ctrl. KeymapNotify repairs a
+ * stale state byte if a release path is interrupted.
+ */
+static void set_control_key_state( BOOL down )
+{
+    BYTE keystate[256];
+
+    /* read the async state, the same array the write below replaces: a
+     * snapshot of the thread queue state could revert a modifier pressed
+     * moments earlier desktop-wide (the KeymapNotify resync reads the
+     * same way) */
+    if (!NtUserGetAsyncKeyboardState( keystate )) return;
+    if (down)
+    {
+        keystate[VK_CONTROL] |= 0x80;
+        keystate[VK_LCONTROL] |= 0x80;
+    }
+    else
+    {
+        keystate[VK_CONTROL] &= ~0x80;
+        keystate[VK_LCONTROL] &= ~0x80;
+    }
+    SERVER_START_REQ( set_key_state )
+    {
+        req->async = 1;
+        wine_server_add_data( req, keystate, 256 );
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+}
+
+/***********************************************************************
+ *           pinch_release_control
+ *
+ * Release a gesture's synthetic Ctrl hold, unless the user is physically
+ * holding a Ctrl: the key state cannot tell a synthetic hold from a
+ * physical one, so the X server's keymap is asked.
+ */
+static void pinch_release_control( struct x11drv_pinch_gesture *gesture, Display *display )
+{
+    char keys[32];
+    KeyCode left, right;
+
+    if (!gesture->ctrl_held) return;
+    gesture->ctrl_held = FALSE;
+    if (display)
+    {
+        XQueryKeymap( display, keys );
+        left = XKeysymToKeycode( display, XK_Control_L );
+        right = XKeysymToKeycode( display, XK_Control_R );
+        if ((left && (keys[left >> 3] >> (left & 7)) & 1) ||
+            (right && (keys[right >> 3] >> (right & 7)) & 1))
+            return;
+    }
+    set_control_key_state( FALSE );
+}
+
+/* hold Ctrl for a beginning gesture; a Ctrl the user already holds is
+ * left alone and never released by us */
+static void pinch_hold_control( struct x11drv_pinch_gesture *gesture )
+{
+    if (NtUserGetAsyncKeyState( VK_CONTROL ) & 0x8000) return;
+    set_control_key_state( TRUE );
+    gesture->ctrl_held = TRUE;
+}
+
+/***********************************************************************
+ *           find_pinch_gesture
+ *
+ * Look up the gesture slot of a physical device. Slots are keyed by the
+ * event's sourceid, not the master deviceid: two slave devices pinching
+ * through one master pointer stay two gestures. XInput2 allows one active
+ * gesture sequence per device, so one slot per source is enough. When every
+ * slot belongs to another device, the stalest gesture is dropped rather
+ * than interleaving two gestures against one baseline.
+ */
+static struct x11drv_pinch_gesture *find_pinch_gesture( struct x11drv_thread_data *data,
+                                                        int sourceid, BOOL create )
+{
+    struct x11drv_pinch_gesture *slot, *free_slot = NULL, *oldest = NULL;
+    int i;
+
+    for (i = 0; i < POINTER_PINCH_SLOTS; i++)
+    {
+        slot = &data->pinch_gestures[i];
+        if (slot->sourceid == sourceid) return slot;
+        if (!slot->sourceid) { if (!free_slot) free_slot = slot; }
+        else if (!oldest || slot->time < oldest->time) oldest = slot;
+    }
+    if (!create) return NULL;
+    if (!free_slot)
+    {
+        TRACE( "dropping the stale pinch gesture of source %d\n", oldest->sourceid );
+        pinch_release_control( oldest, thread_display() );
+        free_slot = oldest;
+    }
+    memset( free_slot, 0, sizeof(*free_slot) );
+    free_slot->sourceid = sourceid;
+    return free_slot;
+}
+
+/***********************************************************************
+ *           pinch_gestures_reset
+ *
+ * Forget every pinch in progress: input focus left the process, or the
+ * device set changed under a running gesture. A gesture's synthetic Ctrl
+ * hold is released on every path through here, so nothing can stay stuck;
+ * there are no key messages to unwind and no cursor anchor to restore.
+ */
+void pinch_gestures_reset(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    int i;
+
+    if (!data) return;
+    for (i = 0; i < POINTER_PINCH_SLOTS; i++)
+    {
+        pinch_release_control( &data->pinch_gestures[i], data->display );
+        data->pinch_gestures[i].sourceid = 0;
+    }
+}
+
+/***********************************************************************
+ *           X11DRV_GesturePinchEvent
+ *
+ * Report a touchpad pinch as the wheel input a Windows precision touchpad
+ * produces for one: the scale change becomes wheel movement whose messages
+ * report MK_CONTROL, so an application that zooms on Ctrl+wheel zooms on a
+ * pinch. The modifier rides each wheel message as a server-side wparam
+ * override. The driver synthesises no Ctrl key event and triggers no
+ * keyboard hook or accelerator. Every exit path releases the held key
+ * state.
+ *
+ * A pinch reports its scale many times a second, so each report is worth a
+ * fraction of a notch and is sent as that fraction. WHEEL_DELTA is a unit,
+ * not a minimum: an application that follows the amount rather than
+ * counting messages zooms continuously.
+ *
+ * The wheel events carry no position. The server uses the current cursor,
+ * which a touchpad pinch does not move. The driver stores no pointer point
+ * and cannot move the cursor through this path.
+ *
+ * On cancellation, the driver sends at most one notch back towards the
+ * starting zoom. The same one-notch limit applies to every update.
+ */
+static BOOL X11DRV_GesturePinchEvent( XGenericEventCookie *xev )
+{
+    /* scale change one whole wheel notch stands for */
+    static const double zoom_step = 1.1;
+    static const int max_delta = WHEEL_DELTA;
+    XIGesturePinchEvent *event = xev->data;
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    UINT time = EVENT_x11_time_to_win32_time( event->time );
+    struct x11drv_pinch_gesture *gesture;
+    double units;
+    int delta;
+    HWND hwnd;
+
+    if (pointer_button_down())
+    {
+        if ((gesture = find_pinch_gesture( data, event->sourceid, FALSE )))
+        {
+            pinch_release_control( gesture, event->display );
+            gesture->sourceid = 0;
+        }
+        return TRUE;
+    }
+
+    if (event->evtype == XI_GesturePinchBegin)
+    {
+        if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+        gesture = find_pinch_gesture( data, event->sourceid, TRUE );
+        gesture->hwnd = hwnd;
+        gesture->scale = 1.0;  /* the protocol defines Begin as scale 1.0 */
+        gesture->net_units = 0.0;
+        gesture->time = event->time;
+        pinch_hold_control( gesture );
+        TRACE( "pinch begin on %lx, source %d\n", event->event, event->sourceid );
+        return TRUE;
+    }
+
+    if (event->evtype == XI_GesturePinchEnd)
+    {
+        if (!(gesture = find_pinch_gesture( data, event->sourceid, FALSE )))
+        {
+            TRACE( "pinch end on source %d without a begin\n", event->sourceid );
+            return TRUE;
+        }
+        if ((event->flags & XIGesturePinchEventCancelled) &&
+            (delta = round( -gesture->net_units )))
+        {
+            if (delta > max_delta) delta = max_delta;
+            else if (delta < -max_delta) delta = -max_delta;
+            TRACE( "pinch cancelled on source %d, returning %d units\n", event->sourceid, delta );
+            send_wheel_control_input( gesture->hwnd, delta, time );
+        }
+        else TRACE( "pinch end on %lx, source %d\n", event->event, event->sourceid );
+        pinch_release_control( gesture, event->display );
+        gesture->sourceid = 0;
+        return TRUE;
+    }
+
+    if (!(event->scale > 0.0)) return FALSE;
+
+    if (!(gesture = find_pinch_gesture( data, event->sourceid, FALSE )))
+    {
+        /* the begin went somewhere else: start from the current scale rather
+         * than dropping the rest of the gesture */
+        if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+        gesture = find_pinch_gesture( data, event->sourceid, TRUE );
+        gesture->hwnd = hwnd;
+        gesture->scale = event->scale;
+        gesture->net_units = 0.0;
+        pinch_hold_control( gesture );
+    }
+    gesture->time = event->time;
+
+    units = WHEEL_DELTA * log( event->scale / gesture->scale ) / log( zoom_step );
+    if ((delta = round( units )) > max_delta) delta = max_delta;
+    else if (delta < -max_delta) delta = -max_delta;
+    if (!delta) return TRUE;
+
+    /* advance by what was reported, so the rest waits for the next update */
+    gesture->scale *= pow( zoom_step, (double)delta / WHEEL_DELTA );
+    gesture->net_units += delta;
+
+    TRACE( "hwnd %p/%lx scale %f delta %d\n", gesture->hwnd, event->event, event->scale, delta );
+
+    send_wheel_control_input( gesture->hwnd, delta, time );
+    return TRUE;
+}
+
+#endif /* XI_GesturePinchBegin */
+
 #endif /* HAVE_X11_EXTENSIONS_XINPUT2_H */
 
+#if !defined(HAVE_X11_EXTENSIONS_XINPUT2_H) || !defined(XI_GesturePinchBegin)
+
+void pinch_gestures_reset(void)
+{
+}
+
+#endif
