From 0db857eeff179a24698a88e0fe93d4c63ce0e31a Mon Sep 17 00:00:00 2001
From: ableton-wine <local@ableton-wine>
Date: Thu, 13 Aug 2026 13:50:09 +0200
Subject: [PATCH] winex11: suspend XI scroll selection during core drags

Smooth scrolling needs XI_Motion for cumulative scroll valuators, but selecting master-device XI events replaces their core equivalents. Leaving XI buttons unselected is not sufficient: as long as XI_Motion stays selected, Wine must still reconstruct drag motion from XI2.

Select XI_Motion only while no ordinary core button is held. On the first core press, replace the window XI mask without XI_Motion and flush it so the X server supplies genuine core MotionNotify events for the implicit grab. Restore XI_Motion after the final core release, and discard any XI motion already queued across the transition. Keep touch and pinch selections unchanged.

Invalidate scroll baselines at both boundaries because scroll valuators can advance while XI_Motion is absent. Tag native smooth reports outside drags before advancing the cumulative baseline and suppress their matching legacy core wheel copies. Leave XIPointerEmulated valuator reports to their stock physical-wheel core copy.

Enable warp emulation by default alongside the other pointer features. The registry and environment settings remain available to disable it.
---
 dlls/winex11.drv/mouse.c  | 253 ++++++++++++++++++++++++--------------
 dlls/winex11.drv/x11drv.h |  12 +-
 dlls/winex11.drv/x11drv_main.c |   2 +-
 3 files changed, 167 insertions(+), 100 deletions(-)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index b5be221..23539e2 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -385,11 +385,6 @@ static void legacy_wheel_copy_tag( const XIDeviceEvent *event,
     unsigned int held_buttons = xinput2_ordinary_button_mask( event );
     unsigned int wheel_buttons = 0;
 
-    if (!held_buttons)
-    {
-        legacy_wheel_copy_reset( "emulated XI report has no held ordinary button" );
-        return;
-    }
     if (have_y)
         wheel_buttons |= legacy_wheel_copy_direction( &src->scroll_y, value_y, 4, 5 );
     if (have_x)
@@ -397,14 +392,14 @@ static void legacy_wheel_copy_tag( const XIDeviceEvent *event,
     if (!wheel_buttons)
     {
         if (copy->valid && copy->time != event->time)
-            legacy_wheel_copy_reset( "new emulated XI report has no legacy copy" );
+            legacy_wheel_copy_reset( "new native XI scroll report has no legacy copy" );
         return;
     }
 
     if (!copy->valid || copy->time != event->time || copy->held_buttons != held_buttons ||
         copy->window != event->event)
     {
-        if (copy->valid) legacy_wheel_copy_reset( "new emulated XI report" );
+        if (copy->valid) legacy_wheel_copy_reset( "new native XI scroll report" );
         copy->time = event->time;
         copy->held_buttons = held_buttons;
         copy->window = event->event;
@@ -412,7 +407,7 @@ static void legacy_wheel_copy_tag( const XIDeviceEvent *event,
         copy->valid = TRUE;
     }
     copy->wheel_buttons |= wheel_buttons;
-    TRACE( "tagged emulated XI legacy copies time %lu window %lx buttons %#x held %#x\n",
+    TRACE( "tagged native XI scroll legacy copies time %lu window %lx buttons %#x held %#x\n",
            copy->time, copy->window, copy->wheel_buttons, copy->held_buttons );
 }
 
@@ -430,7 +425,7 @@ static BOOL legacy_wheel_copy_suppress( const XButtonEvent *event, unsigned int
     button_bit = event->button <= 7 ? LEGACY_WHEEL_BUTTON_BIT( event->button ) : 0;
     if (event->send_event || event->window != copy->window ||
         !(copy->wheel_buttons & button_bit) ||
-        !held_buttons || held_buttons != copy->held_buttons)
+        held_buttons != copy->held_buttons)
     {
         TRACE( "core wheel %u time %lu does not match tagged buttons %#x held %#x/%#x\n",
                event->button, event->time, copy->wheel_buttons,
@@ -678,6 +673,7 @@ void pointer_inertia_tick(LONG input_serial)
  */
 void x11drv_xinput2_enable( Display *display, Window window )
 {
+    struct x11drv_thread_data *data = x11drv_thread_data();
     XIEventMask mask;
     unsigned char mask_bits[XIMaskLen(XI_LASTEVENT)];
 
@@ -690,7 +686,7 @@ void x11drv_xinput2_enable( Display *display, Window window )
 
     if (window == DefaultRootWindow( display ))
     {
-        if (x11drv_thread_data()->root_window_users++) return;
+        if (data->root_window_users++) return;
         XISetMask( mask_bits, XI_DeviceChanged );
         XISetMask( mask_bits, XI_RawMotion );
         XISetMask( mask_bits, XI_ButtonPress );
@@ -701,7 +697,8 @@ void x11drv_xinput2_enable( Display *display, Window window )
         XISetMask( mask_bits, XI_TouchUpdate );
         XISetMask( mask_bits, XI_TouchEnd );
 #ifdef XIScrollClass
-        if (xinput2_smooth_scroll)
+        if (xinput2_smooth_scroll &&
+            !(data->xinput2_core_drag_buttons && data->xinput2_core_drag_window == window))
         {
             HWND hwnd = 0;
             int ctx_missing;
@@ -718,15 +715,19 @@ void x11drv_xinput2_enable( Display *display, Window window )
             if (!ctx_missing) ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
             if (!ctx_missing && !(ex_style & WS_EX_TRANSPARENT))
             {
+                /* Scroll valuators are carried by XI_Motion. Leave every
+                 * button unselected, then drop XI_Motion itself for the
+                 * lifetime of a core button drag below. */
                 XISetMask( mask_bits, XI_Motion );
-                XISetMask( mask_bits, XI_ButtonPress );
-                XISetMask( mask_bits, XI_ButtonRelease );
-                TRACE( "window %lx hwnd %p exstyle %08x: scroll selected\n",
+                TRACE( "window %lx hwnd %p exstyle %08x: XI scroll motion selected outside core drags\n",
                        window, hwnd, (UINT)ex_style );
             }
             else TRACE( "window %lx hwnd %p ctx_missing %d exstyle %08x: scroll NOT selected\n",
                         window, hwnd, ctx_missing, (UINT)ex_style );
         }
+        else if (xinput2_smooth_scroll)
+            TRACE( "window %lx: XI scroll motion deselected for active core drag buttons %#x\n",
+                   window, data->xinput2_core_drag_buttons );
 #endif
 #ifdef XI_GesturePinchBegin
         if (xinput2_gestures)
@@ -747,6 +748,7 @@ void x11drv_xinput2_enable( Display *display, Window window )
  */
 void x11drv_xinput2_disable( Display *display, Window window )
 {
+    struct x11drv_thread_data *data = x11drv_thread_data();
     unsigned char mask_bits[XIMaskLen(XI_LASTEVENT)];
     XIEventMask mask;
 
@@ -759,9 +761,15 @@ void x11drv_xinput2_disable( Display *display, Window window )
 
     if (window == DefaultRootWindow( display ))
     {
-        if (--x11drv_thread_data()->root_window_users) return;
+        if (--data->root_window_users) return;
         XISetMask( mask_bits, XI_DeviceChanged );
     }
+    else if (data->xinput2_core_drag_window == window)
+    {
+        data->xinput2_core_drag_window = None;
+        data->xinput2_core_drag_buttons = 0;
+        data->xinput2_core_drag_motion_seen = FALSE;
+    }
 
     pXISelectEvents( display, window, &mask, 1 );
 }
@@ -1430,6 +1438,64 @@ static unsigned int core_event_button_mask( unsigned int state )
     return mask;
 }
 
+#ifdef XIScrollClass
+/* XISelectEvents replaces this client's master-device mask on the window.
+ * Removing only XI_Motion after the core press therefore leaves Wine's
+ * pre-existing touch and pinch selections intact while restoring genuine
+ * core MotionNotify delivery for the whole implicit grab. */
+static unsigned int xinput2_core_drag_button_bit( unsigned int button )
+{
+    if (!button || button > sizeof(unsigned int) * 8 || pinch_button_is_wheel( button )) return 0;
+    return 1u << (button - 1);
+}
+
+static void xinput2_core_drag_transition( Display *display, Window window,
+                                         unsigned int button, BOOL down )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    unsigned int bit = xinput2_core_drag_button_bit( button );
+
+    if (!xinput2_smooth_scroll || !bit) return;
+    if (down)
+    {
+        if (!data->xinput2_core_drag_buttons)
+        {
+            data->xinput2_core_drag_window = window;
+            data->xinput2_core_drag_motion_seen = FALSE;
+        }
+        else if (data->xinput2_core_drag_window != window)
+        {
+            WARN( "core drag moved from window %lx to %lx while buttons %#x remain held\n",
+                  data->xinput2_core_drag_window, window, data->xinput2_core_drag_buttons );
+            data->xinput2_core_drag_window = window;
+        }
+        data->xinput2_core_drag_buttons |= bit;
+        x11drv_xinput2_enable( display, window );
+        XFlush( display );
+        TRACE( "core button %u suspended XI scroll motion on window %lx; buttons %#x\n",
+               button, window, data->xinput2_core_drag_buttons );
+        return;
+    }
+
+    if (data->xinput2_core_drag_window != window || !(data->xinput2_core_drag_buttons & bit))
+    {
+        WARN( "unmatched core button %u release on window %lx; drag window %lx buttons %#x\n",
+              button, window, data->xinput2_core_drag_window,
+              data->xinput2_core_drag_buttons );
+        return;
+    }
+    data->xinput2_core_drag_buttons &= ~bit;
+    if (data->xinput2_core_drag_buttons) return;
+    TRACE( "core button %u completed drag on window %lx; server core motion seen %u\n",
+           button, window, data->xinput2_core_drag_motion_seen );
+    data->xinput2_core_drag_window = None;
+    data->xinput2_core_drag_motion_seen = FALSE;
+    x11drv_xinput2_enable( display, window );
+    XFlush( display );
+    TRACE( "core button %u restored XI scroll motion on window %lx\n", button, window );
+}
+#endif
+
 /* A real discrete wheel remains ordinary pointer input while another button
  * is stably held. Use the stock path so current capture and MK_* state apply;
  * fixed-position gesture safety remains mandatory for every synthetic,
@@ -2724,14 +2790,25 @@ BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
 {
     XButtonEvent *event = &xev->xbutton;
     UINT button = event->button - 1, flags, time = EVENT_x11_time_to_win32_time( event->time );
-    unsigned int event_button_mask;
+    unsigned int event_button_mask = 0;
     POINT pt = { event->x, event->y }, root = { event->x_root, event->y_root };
     struct x11drv_win_data *data;
 
     TRACE( "hwnd %p/%lx button %u pos %s\n", hwnd, event->window, button, wine_dbgstr_point( &pt ) );
+    if (pinch_button_is_wheel( event->button ))
+        event_button_mask = core_event_button_mask( event->state ) |
+                            (pointer_button_mask() & ((1u << 3) | (1u << 4)));
 #ifdef XIScrollClass
+    if (pinch_button_is_wheel( event->button ) &&
+        legacy_wheel_copy_suppress( event, event_button_mask ))
+        return TRUE;
     if (!pinch_button_is_wheel( event->button ))
-        legacy_wheel_copy_reset( "core button press boundary" );
+    {
+        xinput2_core_drag_transition( event->display, event->window, event->button, TRUE );
+        TRACE( "core button %u begins exclusive stock pointer ownership; invalidating XI scroll baselines\n",
+               event->button );
+        pointer_scroll_invalidate_baselines();
+    }
 #endif
 
     if ((data = get_win_data( hwnd )))
@@ -2754,15 +2831,6 @@ BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
     flags = button_down_flags[button];
     if (pinch_button_is_wheel( event->button ))
     {
-        event_button_mask = core_event_button_mask( event->state ) |
-                            (pointer_button_mask() & ((1u << 3) | (1u << 4)));
-#ifdef XIScrollClass
-        if (legacy_wheel_copy_suppress( event, event_button_mask ))
-        {
-            pinch_button_release( event->button );
-            return TRUE;
-        }
-#endif
         send_discrete_wheel_input( hwnd, pt, flags, button_down_data[button], time,
                                    event_button_mask );
         pinch_button_release( event->button );
@@ -2787,11 +2855,26 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
 {
     XButtonEvent *event = &xev->xbutton;
     UINT button = event->button - 1, flags, time = EVENT_x11_time_to_win32_time( event->time );
+    unsigned int event_button_mask = 0;
     POINT pt = { event->x, event->y }, root = { event->x_root, event->y_root };
 
     TRACE( "hwnd %p/%lx button %u pos %s\n", hwnd, event->window, button, wine_dbgstr_point( &pt ) );
+    if (pinch_button_is_wheel( event->button ))
+        event_button_mask = core_event_button_mask( event->state ) |
+                            (pointer_button_mask() & ((1u << 3) | (1u << 4)));
 #ifdef XIScrollClass
-    legacy_wheel_copy_button_release( event );
+    if (pinch_button_is_wheel( event->button ) &&
+        legacy_wheel_copy_suppress( event, event_button_mask ))
+        return TRUE;
+    if (pinch_button_is_wheel( event->button ))
+        legacy_wheel_copy_button_release( event );
+    else
+    {
+        TRACE( "core button %u ends exclusive stock pointer ownership; invalidating XI scroll baselines\n",
+               event->button );
+        pointer_scroll_invalidate_baselines();
+        xinput2_core_drag_transition( event->display, event->window, event->button, FALSE );
+    }
 #endif
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
@@ -2802,9 +2885,10 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
             pt = map_emulated_warp_coords( event->display, pt, event->time, FALSE );
         warp_emulation_button_release( event->button );
     }
-    /* Never carry a sub-notch remainder across a button release into whatever
-     * target receives later scrolling. */
-    pointer_scroll_discard_remainders();
+    /* Never carry a sub-notch remainder across a physical wheel release.
+     * Ordinary buttons invalidated every cumulative baseline above because
+     * their core grab intentionally hid XI scroll reports for the whole drag. */
+    if (pinch_button_is_wheel( event->button )) pointer_scroll_discard_remainders();
     if (button >= NB_BUTTONS)
     {
         pointer_inertia_cancel();
@@ -2848,6 +2932,20 @@ static BOOL x11drv_motion_notify( HWND hwnd, XEvent *xev, BOOL co_reported_scrol
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
     if (warp_emulation_ignore_synthetic( pt )) return FALSE;
+#ifdef XIScrollClass
+    {
+        struct x11drv_thread_data *data = x11drv_thread_data();
+
+        if (!event->send_event && !co_reported_scroll && data->xinput2_core_drag_buttons &&
+            data->xinput2_core_drag_window == event->window &&
+            !data->xinput2_core_drag_motion_seen)
+        {
+            data->xinput2_core_drag_motion_seen = TRUE;
+            TRACE( "X server delivered core MotionNotify while XI scroll motion is suspended on window %lx\n",
+                   event->window );
+        }
+    }
+#endif
     warp_emulation_reconcile_motion( event->state );
     /* Drag motion is handled above. Standalone pointer movement cancels a
      * coast. Pointer coordinates carried by the same XI2 report as scrolling
@@ -3081,38 +3179,17 @@ static unsigned int xinput2_core_state( const XIDeviceEvent *event )
 }
 
 /***********************************************************************
- *           forward_xinput2_core_event
+ *           forward_xinput2_core_motion
  *
- * Selecting a master-device XI event prevents the X server from delivering
- * its core equivalent.  Feed non-scroll button events and motion through
- * Wine's existing core handlers so smooth scrolling does not replace normal
- * pointer input.
+ * Selecting XI_Motion prevents core delivery of that motion report. Feed
+ * reports without scroll valuators through Wine's existing core handler.
+ * Buttons are deliberately never reconstructed here: they remain selected
+ * only as core events and retain the X server's stock implicit-grab behavior.
  */
-static BOOL forward_xinput2_core_event( HWND hwnd, XIDeviceEvent *event, BOOL co_reported_scroll )
+static BOOL forward_xinput2_core_motion( HWND hwnd, XIDeviceEvent *event, BOOL co_reported_scroll )
 {
     XEvent core = {0};
 
-    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
-    {
-        core.xbutton.type = event->evtype == XI_ButtonPress ? ButtonPress : ButtonRelease;
-        core.xbutton.serial = event->serial;
-        core.xbutton.send_event = event->send_event;
-        core.xbutton.display = event->display;
-        core.xbutton.window = event->event;
-        core.xbutton.root = event->root;
-        core.xbutton.subwindow = event->child;
-        core.xbutton.time = event->time;
-        core.xbutton.x = event->event_x;
-        core.xbutton.y = event->event_y;
-        core.xbutton.x_root = event->root_x;
-        core.xbutton.y_root = event->root_y;
-        core.xbutton.state = xinput2_core_state( event );
-        core.xbutton.button = event->detail;
-        core.xbutton.same_screen = True;
-        if (event->evtype == XI_ButtonPress) return X11DRV_ButtonPress( hwnd, &core );
-        return X11DRV_ButtonRelease( hwnd, &core );
-    }
-
     core.xmotion.type = MotionNotify;
     core.xmotion.serial = event->serial;
     core.xmotion.send_event = event->send_event;
@@ -3965,8 +4042,9 @@ void pointer_inertia_tick(LONG input_serial)
  *           X11DRV_SmoothScrollEvent
  *
  * XInput2 reports touchpad and high-resolution wheel scrolling as cumulative
- * valuator positions. Turn the change into fractional Win32 wheel units and
- * ignore the legacy button events the X server emulates from the same input.
+ * valuator positions on XI_Motion. Turn the change into fractional Win32
+ * wheel units and tag the legacy core wheel copies the X server emits next.
+ * Physical buttons never enter this handler.
  *
  * Outside an active middle drag, the driver updates the cursor and then
  * queues wheel input at the report's fixed screen point. While any button
@@ -3993,36 +4071,18 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
     HWND hwnd;
 
     if (!xinput2_smooth_scroll) return FALSE;
-    if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
-    pt = map_event_coords( hwnd, event->event, event->root, root, pt );
-
-    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
-    {
-        int button = event->detail - 1;
-
-        if (button < 3 || button > 6) return forward_xinput2_core_event( hwnd, event, FALSE );
-        if (event->evtype == XI_ButtonRelease || emulated) return TRUE;
-
-        /* A native XI wheel button is direct input from a device without
-         * scroll axes. It also cancels pinch and continued movement. */
-        notify_button_transition( hwnd, event->detail, TRUE );
-        pinch_button_press( event->display, event->detail );
-        pointer_inertia_cancel();
-        if ((win_data = get_win_data( hwnd )))
-        {
-            /* user-time feeds focus-stealing arbitration only; pushing the
-             * property for every report of a scroll stream wakes the X
-             * server hundreds of times a second for nothing */
-            if ((Time)(event->time - win_data->user_time) >= 100)
-                window_set_user_time( win_data, event->time, FALSE );
-            release_win_data( win_data );
-        }
-        send_discrete_wheel_input( hwnd, pt, button_down_flags[button],
-                                   (int)button_down_data[button], time,
-                                   xinput2_ordinary_button_mask( event ) );
-        pinch_button_release( event->detail );
+    /* XI motion already queued before the ButtonPress handler changed the
+     * selection can still reach this handler. Never reconstruct it as core
+     * drag motion; subsequent movement arrives from the X server as a real
+     * MotionNotify until the final core release restores XI_Motion. */
+    if (data->xinput2_core_drag_buttons && data->xinput2_core_drag_window == event->event)
+    {
+        TRACE( "discarding XI motion queued before core-drag suspension on window %lx\n",
+               event->event );
         return TRUE;
     }
+    if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+    pt = map_event_coords( hwnd, event->event, event->root, root, pt );
 
     if (!(src = find_scroll_source( data, event->sourceid, FALSE )))
     {
@@ -4030,18 +4090,18 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
          * once, when first seen; its axes and baselines stay cached */
         query_scroll_valuators( event->display, event->sourceid );
         if (!(src = find_scroll_source( data, event->sourceid, FALSE )))
-            return forward_xinput2_core_event( hwnd, event, FALSE );
+            return forward_xinput2_core_motion( hwnd, event, FALSE );
     }
     src->time = event->time;
 
     scan_scroll_valuators( event, src, &value_x, &value_y, &have_x, &have_y, &saw_motion );
-    if (!have_x && !have_y) return forward_xinput2_core_event( hwnd, event, FALSE );
+    if (!have_x && !have_y) return forward_xinput2_core_motion( hwnd, event, FALSE );
 
     if (emulated)
     {
-        /* the emulated report only refreshes the baselines; the same
-         * movement arrives as core wheel buttons */
-        legacy_wheel_copy_tag( event, src, have_x, value_x, have_y, value_y );
+        /* A physical discrete wheel was expanded into this emulated XI
+         * valuator report. Refresh the baselines and let its core button copy
+         * take Wine's stock wheel path; do not arm duplicate suppression. */
         if (have_x) smooth_scroll_delta( &src->scroll_x, value_x, TRUE, FALSE, NULL );
         if (have_y) smooth_scroll_delta( &src->scroll_y, value_y, TRUE, FALSE, NULL );
         if (have_x) { src->scroll_x.last_value = value_x; src->scroll_x.last_value_valid = TRUE; }
@@ -4052,6 +4112,11 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
         return TRUE;
     }
 
+    /* Native smooth input is queued before its emulated core Button4--7
+     * copies. Correlate those copies before advancing either cumulative
+     * baseline so they cannot deliver the same scroll a second time. */
+    legacy_wheel_copy_tag( event, src, have_x, value_x, have_y, value_y );
+
     /* While the user holds any button, keep scroll baselines current without
      * sending smooth wheel input to the dragged control. */
     buttons_down = xinput2_any_button_down( event );
@@ -4060,7 +4125,7 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
     /* Ignore pointer motion from a smooth-scroll report during an ordinary
      * button drag. Continue sending this motion during middle navigation. */
     if (saw_motion && (!buttons_down || data->middle_drag.active))
-        forward_xinput2_core_event( hwnd, event, TRUE );
+        forward_xinput2_core_motion( hwnd, event, TRUE );
     else if (saw_motion)
         TRACE( "Wine ignores pointer motion from a scroll report while a button is held\n" );
 
@@ -4668,8 +4733,6 @@ BOOL X11DRV_GenericEvent( HWND hwnd, XEvent *xev )
 
 #ifdef XIScrollClass
     case XI_Motion:
-    case XI_ButtonPress:
-    case XI_ButtonRelease:
         ret = X11DRV_SmoothScrollEvent( event );
         break;
 
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index c655e55..e62f941 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -426,7 +426,7 @@ struct x11drv_pointer_config pointer_config =
     .wheel_while_button_held = POINTER_WHEEL_WHILE_BUTTON_HELD_ENABLED,
     .inertia_curve    = POINTER_INERTIA_CURVE_EXPONENTIAL,
-    .warp_emulation   = POINTER_WARP_DISABLED,
+    .warp_emulation   = POINTER_WARP_ENABLED,
     .inertia_rate     = 4.0,
 };
 
 /* Earlier development builds of these features read different names, and
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 1c38c39..12fde1f 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -520,14 +520,15 @@ struct x11drv_scroll_source
     struct x11drv_scroll_axis scroll_y;
 };
 
-/* One XInput2 smooth report may be followed by several legacy wheel-button
- * copies carrying the same X server timestamp. This state is per X connection
- * (and therefore per Wine interface thread), like the ordered event queue. */
+/* One native XInput2 smooth report may be followed by several emulated core
+ * wheel-button copies carrying the same X server timestamp. This state is per
+ * X connection (and therefore per Wine interface thread), like the ordered
+ * event queue. */
 struct x11drv_legacy_wheel_copy
