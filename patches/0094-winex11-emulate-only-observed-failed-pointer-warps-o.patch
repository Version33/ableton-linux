+/***********************************************************************
+ *              warp_emulation_cancel
+ *
+ * End the process-wide drag and forget its button ownership.  Callers use
+ * this for discontinuities where a later release may be delivered to another
+ * thread, or may never arrive at all.
+ */
+void warp_emulation_cancel(void)
+{
+    pthread_mutex_lock( &warp_emulation_mutex );
+    if (warp_emulation.pending || warp_emulation.reporting)
+        TRACE( "cancelling XWayland warp emulation\n" );
+    memset( &warp_emulation, 0, sizeof(warp_emulation) );
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+
+static void warp_emulation_disarm(void)
+{
+    pthread_mutex_lock( &warp_emulation_mutex );
+    warp_emulation.generation++;
+    warp_emulation.failed_votes = 0;
+    warp_emulation.pending = FALSE;
+    warp_emulation.reporting = FALSE;
+    warp_emulation.synthetic_pending = FALSE;
+    warp_emulation.raw_seen = FALSE;
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+
+static void warp_emulation_button_press( unsigned int button )
+{
+    unsigned int index = button - 1, bit;
+
+    if (!button || index >= NB_BUTTONS) return;
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    warp_emulation.generation++;
+    warp_emulation.failed_votes = 0;
+    warp_emulation.pending = FALSE;
+    warp_emulation.reporting = FALSE;
+    warp_emulation.synthetic_pending = FALSE;
+    warp_emulation.raw_seen = FALSE;
+    /* Wheel requests are X buttons too, but they are transitions rather than
+     * held drag ownership. They cancel a probe without remaining latched. */
+    if (button_up_flags[index])
+    {
+        bit = 1u << index;
+        warp_emulation.buttons |= bit;
+    }
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+
+static void warp_emulation_button_release( unsigned int button )
+{
+    unsigned int index = button - 1, bit;
+
+    if (!button || index >= NB_BUTTONS) return;
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    warp_emulation.generation++;
+    warp_emulation.failed_votes = 0;
+    warp_emulation.pending = FALSE;
+    warp_emulation.reporting = FALSE;
+    warp_emulation.synthetic_pending = FALSE;
+    warp_emulation.raw_seen = FALSE;
+    if (button_up_flags[index])
+    {
+        bit = 1u << index;
+        warp_emulation.buttons &= ~bit;
+    }
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+
+static BOOL warp_emulation_available( Display *display )
+{
+    LONG cached;
+    int opcode, event, error;
+
+    if (pointer_config.warp_emulation == POINTER_WARP_DISABLED) return FALSE;
+    cached = InterlockedCompareExchange( &xwayland_server, 0, 0 );
+    if (cached < 0)
+    {
+        LONG detected = XQueryExtension( display, "XWAYLAND", &opcode, &event, &error );
+
+        InterlockedCompareExchange( &xwayland_server, detected, -1 );
+        cached = InterlockedCompareExchange( &xwayland_server, 0, 0 );
+        TRACE( "XWayland warp observation %s\n", cached ? "available" : "not needed" );
+    }
+    return cached != 0;
+}
+
+static unsigned int warp_emulation_xstate_buttons( unsigned int state )
+{
+    unsigned int buttons = 0;
+
+    if (state & Button1Mask) buttons |= 1u << 0;
+    if (state & Button2Mask) buttons |= 1u << 1;
+    if (state & Button3Mask) buttons |= 1u << 2;
+    return buttons;
+}
+
+static void warp_emulation_record_warp( POINT target, POINT prewarp, unsigned int state )
+{
+    unsigned int buttons = warp_emulation_xstate_buttons( state );
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    warp_emulation.generation++;
+    /* XQueryPointer exposes only the first five core button masks. Preserve
+     * any extended held button observed through its X event so a chord cannot
+     * look like one eligible ordinary button. */
+    buttons |= warp_emulation.buttons & ~7u;
+    /* XQueryPointer is the final cross-thread truth.  Only one ordinary held
+     * button is a relative drag; wheel and chorded input never arm emulation. */
+    if (!(buttons & 7u) || (buttons & (buttons - 1)))
+    {
+        warp_emulation.buttons = buttons;
+        warp_emulation.failed_votes = 0;
+        warp_emulation.pending = FALSE;
+        warp_emulation.reporting = FALSE;
+        warp_emulation.synthetic_pending = FALSE;
+        warp_emulation.raw_seen = FALSE;
+        pthread_mutex_unlock( &warp_emulation_mutex );
+        return;
+    }
+
+    warp_emulation.buttons = buttons;
+    warp_emulation.target = target;
+    warp_emulation.prewarp = prewarp;
+    warp_emulation.reported = target;
+    warp_emulation.synthetic_pending = TRUE;
+    warp_emulation.raw_seen = FALSE;
+    warp_emulation.raw_conflict = FALSE;
+    warp_emulation.raw_generation = 0;
+    warp_emulation.raw_display = NULL;
+    warp_emulation.raw_sourceid = 0;
+    warp_emulation.raw_time = 0;
+    warp_emulation.raw_dx = warp_emulation.raw_dy = 0.0;
+    warp_emulation.pending = TRUE;
+    warp_emulation.reporting = pointer_config.warp_emulation == POINTER_WARP_ENABLED ||
+                               warp_emulation.failed_votes >= WARP_EMULATION_FAILURE_VOTES;
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+
+static double warp_point_distance( POINT a, POINT b )
+{
+    return max( fabs( (double)a.x - b.x ), fabs( (double)a.y - b.y ) );
+}
+
+/* Decide from the first non-synthetic event after a warp.  The accelerated
+ * raw delta lets us distinguish a cooked event based on the server's pre-warp
+ * point from one based on the requested target. */
+static enum warp_probe_result warp_emulation_probe( Display *display, POINT pos, Time time )
+{
+    double span = warp_point_distance( warp_emulation.target, warp_emulation.prewarp );
+    POINT failed, applied;
+    double failed_error, applied_error, tolerance;
+
+    if (span < 8.0 || !warp_emulation.raw_seen || warp_emulation.raw_conflict ||
+        warp_emulation.raw_generation != warp_emulation.generation ||
+        warp_emulation.raw_display != display || warp_emulation.raw_time != time)
+        return WARP_PROBE_AMBIGUOUS;
+
+    failed.x = warp_emulation.prewarp.x + round( warp_emulation.raw_dx );
+    failed.y = warp_emulation.prewarp.y + round( warp_emulation.raw_dy );
+    applied.x = warp_emulation.target.x + round( warp_emulation.raw_dx );
+    applied.y = warp_emulation.target.y + round( warp_emulation.raw_dy );
+    failed_error = warp_point_distance( pos, failed );
+    applied_error = warp_point_distance( pos, applied );
+    tolerance = min( 8.0, max( 2.0, span / 8.0 ) );
+
+    if (failed_error <= tolerance && applied_error >= failed_error + span / 2.0)
+        return WARP_PROBE_FAILED;
+    if (applied_error <= tolerance && failed_error >= applied_error + span / 2.0)
+        return WARP_PROBE_APPLIED;
+    return WARP_PROBE_AMBIGUOUS;
+}
+
+static POINT map_emulated_warp_coords( Display *display, POINT pos, Time time, BOOL allow_probe )
+{
+    enum warp_probe_result probe = WARP_PROBE_AMBIGUOUS;
+    BOOL newly_active = FALSE;
+    POINT result = pos;
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    if (!warp_emulation.buttons || (warp_emulation.buttons & (warp_emulation.buttons - 1))) goto done;
+
+    if (warp_emulation.pending)
+    {
+        warp_emulation.pending = FALSE;
+        if (pointer_config.warp_emulation == POINTER_WARP_ENABLED)
+            warp_emulation.reporting = TRUE;
+        else if (allow_probe)
+        {
+            probe = warp_emulation_probe( display, pos, time );
+            if (probe == WARP_PROBE_FAILED)
+            {
+                if (warp_emulation.failed_votes < WARP_EMULATION_FAILURE_VOTES)
+                    warp_emulation.failed_votes++;
+                newly_active = !warp_emulation.reporting &&
+                               warp_emulation.failed_votes >= WARP_EMULATION_FAILURE_VOTES;
+                warp_emulation.reporting = warp_emulation.failed_votes >= WARP_EMULATION_FAILURE_VOTES;
+            }
+            else
+            {
+                /* Successful and ambiguous warps always pass through.  This is
+                 * the guard against double-emulating XWayland's own relative-
+                 * pointer path. */
+                warp_emulation.failed_votes = 0;
+                warp_emulation.reporting = FALSE;
+            }
+        }
+    }
+
+    if (!warp_emulation.reporting) goto done;
+    warp_emulation.reported.x = warp_emulation.target.x + pos.x - warp_emulation.prewarp.x;
+    warp_emulation.reported.y = warp_emulation.target.y + pos.y - warp_emulation.prewarp.y;
+    result = warp_emulation.reported;
+
+done:
+    pthread_mutex_unlock( &warp_emulation_mutex );
+    if (newly_active && !InterlockedCompareExchange( &warp_activation_reported, 1, 0 ))
+        WARN_(winediag)( "XWayland warp emulation activated after observed failed warps\n" );
+    TRACE( "warp probe %d cooked %s reported %s\n", probe,
+           wine_dbgstr_point( &pos ), wine_dbgstr_point( &result ) );
+    return result;
+}
+
+#ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
+static void warp_emulation_raw_motion( Display *display, int sourceid, Time time, double dx, double dy )
+{
+    pthread_mutex_lock( &warp_emulation_mutex );
+    if (warp_emulation.pending)
+    {
+        if (!warp_emulation.raw_seen)
+        {
+            warp_emulation.raw_seen = TRUE;
+            warp_emulation.raw_generation = warp_emulation.generation;
+            warp_emulation.raw_display = display;
+            warp_emulation.raw_sourceid = sourceid;
+            warp_emulation.raw_time = time;
+            warp_emulation.raw_dx = dx;
+            warp_emulation.raw_dy = dy;
+        }
+        else if (warp_emulation.raw_generation == warp_emulation.generation &&
+                 warp_emulation.raw_display == display &&
+                 warp_emulation.raw_sourceid == sourceid && warp_emulation.raw_time == time)
+        {
+            warp_emulation.raw_dx += dx;
+            warp_emulation.raw_dy += dy;
+        }
+        else warp_emulation.raw_conflict = TRUE;
+    }
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+#endif
+
+/* X serials belong to one Display connection.  A warp issued by one Wine
+ * thread can therefore generate its target MotionNotify on several attached
+ * threads, where is_old_motion_event() cannot recognise the request serial.
+ * Suppress every exact-target copy until the first non-target cooked motion;
+ * the next warp generation replaces this target if no such motion arrives. */
+static BOOL warp_emulation_ignore_synthetic( POINT pos )
+{
+    BOOL ignore = FALSE;
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    if (warp_emulation.synthetic_pending && pos.x == warp_emulation.target.x &&
+        pos.y == warp_emulation.target.y) ignore = TRUE;
+    else if (warp_emulation.synthetic_pending) warp_emulation.synthetic_pending = FALSE;
+    pthread_mutex_unlock( &warp_emulation_mutex );
+    if (ignore) TRACE( "ignoring cross-thread synthetic warp motion at %s\n", wine_dbgstr_point( &pos ) );
+    return ignore;
+}
+
+static void warp_emulation_reconcile_motion( unsigned int state )
+{
+    unsigned int buttons = warp_emulation_xstate_buttons( state );
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    if ((warp_emulation.buttons & 7u) != buttons)
+    {
+        warp_emulation.generation++;
+        warp_emulation.failed_votes = 0;
+        warp_emulation.pending = FALSE;
+        warp_emulation.reporting = FALSE;
+        warp_emulation.synthetic_pending = FALSE;
+        warp_emulation.raw_seen = FALSE;
+        warp_emulation.buttons = buttons;
+    }
+    pthread_mutex_unlock( &warp_emulation_mutex );
+}
+
+static BOOL warp_emulation_get_position( POINT *pos )
+{
+    BOOL reporting;
+
+    pthread_mutex_lock( &warp_emulation_mutex );
+    reporting = warp_emulation.reporting;
+    if (reporting) *pos = warp_emulation.reported;
+    pthread_mutex_unlock( &warp_emulation_mutex );
+    return reporting;
+}
+
 static BOOL send_mouse_input( HWND hwnd, POINT pos, UINT flags, UINT data, UINT time,
                               const struct raw_mouse *raw )
 {
@@ -2057,9 +2397,15 @@ BOOL X11DRV_SetCursorPos( INT x, INT y )
 {
     struct x11drv_thread_data *data = x11drv_init_thread_data();
     POINT pos = virtual_screen_to_root( x, y );
+    POINT prewarp = {0};
+    Window query_root, child;
+    int root_x, root_y, win_x, win_y;
+    unsigned int state;
+    BOOL observe_warp = FALSE;
 
     if (keyboard_grabbed)
     {
+        warp_emulation_disarm();
         WARN( "refusing to warp to %u, %u\n", pos.x, pos.y );
         return FALSE;
     }
@@ -2069,13 +2415,29 @@ BOOL X11DRV_SetCursorPos( INT x, INT y )
                       PointerMotionMask | ButtonPressMask | ButtonReleaseMask,
                       GrabModeAsync, GrabModeAsync, None, None, CurrentTime ) != GrabSuccess)
     {
+        warp_emulation_disarm();
