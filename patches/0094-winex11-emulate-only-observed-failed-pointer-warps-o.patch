     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (warp_emulation_ignore_synthetic( pt )) return FALSE;
+    warp_emulation_reconcile_motion( event->state );
     /* Drag motion is handled above. Other pointer movement cancels a coast. */
     if (middle_drag_motion( event, pt, time )) return TRUE;
+    pt = map_emulated_warp_coords( event->display, pt, event->time, TRUE );
     pointer_inertia_cancel();
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
     return TRUE;
