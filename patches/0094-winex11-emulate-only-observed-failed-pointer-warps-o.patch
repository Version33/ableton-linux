+    if (button >= NB_BUTTONS) warp_emulation_cancel();
+    else
+    {
+        if (button_up_flags[button])
+            pt = map_emulated_warp_coords( event->display, pt, event->time, FALSE );
+        warp_emulation_button_release( event->button );
+    }
