 #ifdef XIScrollClass
     /* the event carries the complete replacement class list; rebuild the
@@ -2398,6 +2778,9 @@ static POINT map_raw_event_coords( XIRawEvent *event, POINT *raw )
         values++;
     }
 
+    warp_emulation_raw_motion( event->display, event->sourceid, event->time,
+                               x_value * x_scale, y_value * y_scale );
+
     /* when not clipping cursor, we use MotionNotify for absolute mouse position */
     if (!thread_data->clipping_cursor)
