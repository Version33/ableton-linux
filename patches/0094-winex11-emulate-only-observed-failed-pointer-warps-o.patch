+/* X events can cross Wine threads after input attachment.  Keep one process
+ * state so a release, focus loss, or capture loss on another X11 thread still
+ * terminates the drag which armed emulation. */
+static struct
+{
+    unsigned int buttons;
+    unsigned int failed_votes;
+    BOOL pending;
+    BOOL reporting;
+    BOOL synthetic_pending;
+    BOOL raw_seen;
+    BOOL raw_conflict;
+    unsigned long generation;
+    unsigned long raw_generation;
+    Display *raw_display;
+    int raw_sourceid;
+    Time raw_time;
+    double raw_dx;
+    double raw_dy;
+    POINT target;
+    POINT prewarp;
+    POINT reported;
+} warp_emulation;
+static pthread_mutex_t warp_emulation_mutex = PTHREAD_MUTEX_INITIALIZER;
+static volatile LONG xwayland_server = -1;
+static volatile LONG warp_activation_reported;
