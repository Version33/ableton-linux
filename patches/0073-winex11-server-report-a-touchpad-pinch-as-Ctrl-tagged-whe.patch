+/***********************************************************************
+ *           send_wheel_control_input
+ *
+ * Send a wheel-only event whose message reports MK_CONTROL without any key
+ * input existing: SEND_HWMSG_FORCE_MK_CONTROL makes the server set the
+ * modifier in this message's wparam only. No key event is synthesized, no
+ * key state changes anywhere, and a Ctrl the user physically holds is
+ * unaffected, so nothing can stick and nothing needs restoring.
+ */
+static void send_wheel_control_input( HWND hwnd, int delta, UINT time )
+{
+    INPUT input = { .type = INPUT_MOUSE };
+
+    input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+    input.mi.mouseData = delta;
+    input.mi.time = time;
+
+    NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT | SEND_HWMSG_FORCE_MK_CONTROL, &input, 0 );
+}
+
 /* movement one wheel notch stands for, in raw virtual screen pixels */
 #define MIDDLE_DRAG_STEP 24
 
