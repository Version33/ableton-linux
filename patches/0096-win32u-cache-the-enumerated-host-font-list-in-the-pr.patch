+static UINT64 host_fonts_stamp_hash( UINT64 hash, const void *data, size_t len )
+{
+    const unsigned char *p = data;
+    while (len--)
+    {
+        hash ^= *p++;
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}
+
+/* Fold one stat result into an entry hash: the size and the full-precision
+ * mtime. A file replaced within one second still changes the stamp. */
+static UINT64 host_fonts_stamp_stat( UINT64 entry, const struct stat *st )
+{
+    UINT64 size = st->st_size, sec;
+    DWORD nsec;
+#ifdef HAVE_STRUCT_STAT_ST_MTIM
+    sec  = st->st_mtim.tv_sec;
+    nsec = st->st_mtim.tv_nsec;
+#elif defined(HAVE_STRUCT_STAT_ST_MTIMESPEC)
+    sec  = st->st_mtimespec.tv_sec;
+    nsec = st->st_mtimespec.tv_nsec;
+#else
+    sec  = st->st_mtime;
+    nsec = 0;
+#endif
+    entry = host_fonts_stamp_hash( entry, &size, sizeof(size) );
+    entry = host_fonts_stamp_hash( entry, &sec, sizeof(sec) );
+    return host_fonts_stamp_hash( entry, &nsec, sizeof(nsec) );
+}
+
+struct host_fonts_stamp
+{
+    unsigned int entries;
+    BOOL         failed;   /* an input the stamp cannot cover: the cache stays off */
+};
+
+#define HOST_FONTS_STAMP_MAX_DEPTH   8
+#define HOST_FONTS_STAMP_MAX_ENTRIES 65536
+
+/* Stamp one directory tree: fold every entry's name, and for regular files
+ * the size and mtime, into an order-independent hash. readdir order varies
+ * between filesystems, so entries combine with xor rather than sequentially.
+ * Dot-prefixed names count like any other: fontconfig reads them too. A
+ * tree that overruns the depth or entry limit marks the stamp failed, and
+ * the cache stays off instead of using a key over a partial view. */
+static UINT64 host_fonts_stamp_dir( const char *path, unsigned int depth, struct host_fonts_stamp *stamp )
+{
+    UINT64 hash = 0, entry;
+    DIR *dir;
+    struct dirent *ent;
+    struct stat st;
+    char buffer[1024];
+    size_t len = strlen( path );
+
+    if (depth >= HOST_FONTS_STAMP_MAX_DEPTH || len >= sizeof(buffer) - 2)
+    {
+        stamp->failed = TRUE;
+        return hash;
+    }
+    if (!(dir = opendir( path ))) return hash;
+    memcpy( buffer, path, len );
+    buffer[len++] = '/';
+    while (!stamp->failed && (ent = readdir( dir )))
+    {
+        size_t name_len = strlen( ent->d_name );
+        if (!strcmp( ent->d_name, "." ) || !strcmp( ent->d_name, ".." )) continue;
+        if (++stamp->entries > HOST_FONTS_STAMP_MAX_ENTRIES || len + name_len >= sizeof(buffer))
+        {
+            stamp->failed = TRUE;
+            break;
+        }
+        memcpy( buffer + len, ent->d_name, name_len + 1 );
+        entry = host_fonts_stamp_hash( 1469598103934665603ull, ent->d_name, name_len );
+        if (stat( buffer, &st ))
+            /* present but not statable: the name still counts, so the entry
+             * appearing or disappearing changes the stamp */
+            entry = host_fonts_stamp_hash( entry, "?", 1 );
+        else if (S_ISDIR( st.st_mode ))
+            entry ^= host_fonts_stamp_dir( buffer, depth + 1, stamp );
+        else
+            entry = host_fonts_stamp_stat( entry, &st );
+        hash ^= entry;
+    }
+    closedir( dir );
+    return hash;
+}
+
+/* The face list depends on more than the font files: the fontconfig
+ * configuration supplies the directory list and the per-pattern and
+ * default antialiasing properties, the locale picks the face names at
+ * parse time, and the antialiasing defaults are folded into every face's
+ * flags. Stamp them all so a change to any of them reruns the
+ * enumeration instead of replaying faces built from stale inputs. */
+static UINT64 host_fonts_stamp_config( FcConfig *config, struct host_fonts_stamp *stamp )
+{
+    UINT64 hash = 1469598103934665603ull;
+    FcStrList *files;
+    const FcChar8 *file;
+    struct stat st;
+    int fc_version;
+    UINT lcid = system_lcid, aa_flags = default_aa_flags;
+
+    if (!pFcConfigGetConfigFiles || !pFcGetVersion)
+    {
+        stamp->failed = TRUE;
+        return hash;
+    }
+    fc_version = pFcGetVersion();
+    hash = host_fonts_stamp_hash( hash, &fc_version, sizeof(fc_version) );
+    hash = host_fonts_stamp_hash( hash, &lcid, sizeof(lcid) );
+    hash = host_fonts_stamp_hash( hash, &aa_flags, sizeof(aa_flags) );
+    if (!(files = pFcConfigGetConfigFiles( config )))
+    {
+        stamp->failed = TRUE;
+        return hash;
+    }
+    /* folded in list order: the load order decides which config file wins */
+    while ((file = pFcStrListNext( files )))
+    {
+        hash = host_fonts_stamp_hash( hash, file, strlen( (const char *)file ) + 1 );
+        if (stat( (const char *)file, &st )) hash = host_fonts_stamp_hash( hash, "?", 1 );
+        else hash = host_fonts_stamp_stat( hash, &st );
+    }
+    pFcStrListDone( files );
+    return hash;
+}
+
+static UINT64 fontconfig_host_fonts_stamp(void)
+{
+    UINT64 hash = 1469598103934665603ull, config_hash;
+    struct host_fonts_stamp stamp = { 0 };
+    FcStrList *dir_list;
+    const FcChar8 *dir;
+    FcConfig *config;
+
+    if (!fontconfig_enabled) return 0;
+    if (!(config = pFcConfigGetCurrent())) return 0;
+    config_hash = host_fonts_stamp_config( config, &stamp );
+    hash = host_fonts_stamp_hash( hash, &config_hash, sizeof(config_hash) );
+    if (!(dir_list = pFcConfigGetFontDirs( config ))) return 0;
+    while ((dir = pFcStrListNext( dir_list )))
+    {
+        hash = host_fonts_stamp_hash( hash, dir, strlen( (const char *)dir ) + 1 );
+        hash ^= host_fonts_stamp_dir( (const char *)dir, 0, &stamp );
+    }
+    pFcStrListDone( dir_list );
+    if (stamp.failed)
+    {
+        TRACE( "host font stamp failed, the cache stays off\n" );
+        return 0;
+    }
+    hash = host_fonts_stamp_hash( hash, &stamp.entries, sizeof(stamp.entries) );
+    TRACE( "host font stamp %s over %u entries\n", wine_dbgstr_longlong(hash), stamp.entries );
+    return hash ? hash : 1;
+}
