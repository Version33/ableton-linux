+static unsigned int pointer_button_mask(void)
+{
+    unsigned int mask = 0;
+
+    if (NtUserGetKeyState( VK_LBUTTON ) & 0x8000) mask |= 1u << 0;
+    if (NtUserGetKeyState( VK_MBUTTON ) & 0x8000) mask |= 1u << 1;
+    if (NtUserGetKeyState( VK_RBUTTON ) & 0x8000) mask |= 1u << 2;
+    if (NtUserGetKeyState( VK_XBUTTON1 ) & 0x8000) mask |= 1u << 3;
+    if (NtUserGetKeyState( VK_XBUTTON2 ) & 0x8000) mask |= 1u << 4;
+    return mask;
+}
+
 static BOOL pointer_button_down(void)
 {
-    return (NtUserGetKeyState( VK_LBUTTON ) | NtUserGetKeyState( VK_MBUTTON ) |
-            NtUserGetKeyState( VK_RBUTTON ) | NtUserGetKeyState( VK_XBUTTON1 ) |
-            NtUserGetKeyState( VK_XBUTTON2 )) & 0x8000;
+    return pointer_button_mask() != 0;
+}
+
+static unsigned int core_event_button_mask( unsigned int state )
+{
+    unsigned int mask = 0;
+
+    if (state & Button1Mask) mask |= 1u << 0;
+    if (state & Button2Mask) mask |= 1u << 1;
+    if (state & Button3Mask) mask |= 1u << 2;
+    return mask;
+}
+
+/* A real discrete wheel remains ordinary pointer input while another button
+ * is stably held. Use the stock path so current capture and MK_* state apply;
+ * fixed-position gesture safety remains mandatory for every synthetic,
+ * delayed, smooth-valuator, pinch, and middle-drag packet. */
+static BOOL send_discrete_wheel_input( HWND hwnd, POINT pt, UINT flags, int delta, UINT time,
+                                       unsigned int event_button_mask )
+{
+    unsigned int held_button_mask = pointer_button_mask();
+
+    if (pointer_config.wheel_while_button_held == POINTER_WHEEL_WHILE_BUTTON_HELD_ENABLED &&
+        event_button_mask && event_button_mask == held_button_mask &&
+        !x11drv_thread_data()->middle_drag.active)
+    {
+        TRACE( "discrete wheel %d follows stock held-button path\n", delta );
+        return send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, delta, time, NULL );
+    }
+    if (event_button_mask || held_button_mask || x11drv_thread_data()->middle_drag.active)
+    {
+        TRACE( "discrete wheel %d suppressed: unstable held-button state or middle drag\n", delta );
+        return TRUE;
+    }
+    return send_wheel_at_input( hwnd, pt, flags, delta, time, NULL, FALSE );
 }
 
