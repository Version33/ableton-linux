--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -338,6 +338,124 @@ static void update_relative_valuators( XIAnyClassInfo **classes, int num_classes
 #ifdef XIScrollClass
 static BOOL xinput2_smooth_scroll;
 
+#define LEGACY_WHEEL_BUTTON_BIT(button) (1u << (button))
+
+static unsigned int xinput2_ordinary_button_mask( const XIDeviceEvent *event )
+{
+    static const unsigned int buttons[] = { 1, 2, 3, 8, 9 };
+    unsigned int mask = 0, i;
+
+    for (i = 0; i < ARRAY_SIZE( buttons ); i++)
+        if (buttons[i] / 8 < event->buttons.mask_len &&
+            XIMaskIsSet( event->buttons.mask, buttons[i] )) mask |= 1u << i;
+    return mask;
+}
+
+static void legacy_wheel_copy_reset( const char *reason )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_legacy_wheel_copy *copy;
+
+    if (!data || !(copy = &data->legacy_wheel_copy)->valid) return;
+    TRACE( "legacy wheel-copy tag time %lu buttons %#x cleared: %s\n",
+           copy->time, copy->wheel_buttons, reason );
+    memset( copy, 0, sizeof(*copy) );
+}
+
+static unsigned int legacy_wheel_copy_direction( const struct x11drv_scroll_axis *axis,
+                                                 double value, unsigned int negative_button,
+                                                 unsigned int positive_button )
+{
+    double units;
+
+    /* With no prior XI value, direction cannot be recovered. Restrict the
+     * wildcard to this axis and let timestamp plus held state correlate it. */
+    if (!axis->last_value_valid)
+        return LEGACY_WHEEL_BUTTON_BIT( negative_button ) |
+               LEGACY_WHEEL_BUTTON_BIT( positive_button );
+    if (!(units = (value - axis->last_value) / axis->increment)) return 0;
+    return LEGACY_WHEEL_BUTTON_BIT( units < 0.0 ? negative_button : positive_button );
+}
+
+static void legacy_wheel_copy_tag( const XIDeviceEvent *event,
+                                   const struct x11drv_scroll_source *src,
+                                   BOOL have_x, double value_x, BOOL have_y, double value_y )
+{
+    struct x11drv_legacy_wheel_copy *copy = &x11drv_thread_data()->legacy_wheel_copy;
+    unsigned int held_buttons = xinput2_ordinary_button_mask( event );
+    unsigned int wheel_buttons = 0;
+
+    if (!held_buttons)
+    {
+        legacy_wheel_copy_reset( "emulated XI report has no held ordinary button" );
+        return;
+    }
+    if (have_y)
+        wheel_buttons |= legacy_wheel_copy_direction( &src->scroll_y, value_y, 4, 5 );
+    if (have_x)
+        wheel_buttons |= legacy_wheel_copy_direction( &src->scroll_x, value_x, 6, 7 );
+    if (!wheel_buttons)
+    {
+        if (copy->valid && copy->time != event->time)
+            legacy_wheel_copy_reset( "new emulated XI report has no legacy copy" );
+        return;
+    }
+
+    if (!copy->valid || copy->time != event->time || copy->held_buttons != held_buttons ||
+        copy->window != event->event)
+    {
+        if (copy->valid) legacy_wheel_copy_reset( "new emulated XI report" );
+        copy->time = event->time;
+        copy->held_buttons = held_buttons;
+        copy->window = event->event;
+        copy->wheel_buttons = 0;
+        copy->valid = TRUE;
+    }
+    copy->wheel_buttons |= wheel_buttons;
+    TRACE( "tagged emulated XI legacy copies time %lu window %lx buttons %#x held %#x\n",
+           copy->time, copy->window, copy->wheel_buttons, copy->held_buttons );
+}
+
+static BOOL legacy_wheel_copy_suppress( const XButtonEvent *event, unsigned int held_buttons )
+{
+    struct x11drv_legacy_wheel_copy *copy = &x11drv_thread_data()->legacy_wheel_copy;
+    unsigned int button_bit;
+
+    if (!copy->valid) return FALSE;
+    if (event->time != copy->time)
+    {
+        legacy_wheel_copy_reset( "legacy core wheel time changed" );
+        return FALSE;
+    }
+    button_bit = event->button <= 7 ? LEGACY_WHEEL_BUTTON_BIT( event->button ) : 0;
+    if (event->send_event || event->window != copy->window ||
+        !(copy->wheel_buttons & button_bit) ||
+        !held_buttons || held_buttons != copy->held_buttons)
+    {
+        TRACE( "core wheel %u time %lu does not match tagged buttons %#x held %#x/%#x\n",
+               event->button, event->time, copy->wheel_buttons,
+               held_buttons, copy->held_buttons );
+        return FALSE;
+    }
+
+    /* Do not consume the direction bit. One smooth report can generate more
+     * than one vertical and horizontal legacy press, all at the same X time. */
+    TRACE( "suppressing tagged emulated legacy core wheel %u time %lu held %#x\n",
+           event->button, event->time, held_buttons );
+    return TRUE;
+}
+
+static void legacy_wheel_copy_button_release( const XButtonEvent *event )
+{
+    struct x11drv_legacy_wheel_copy *copy = &x11drv_thread_data()->legacy_wheel_copy;
+
+    if (!copy->valid) return;
+    /* Same-time press/release pairs may be interleaved for several generated
+     * notches. A later release is the end of the correlated legacy sequence. */
+    if (!pinch_button_is_wheel( event->button ) || event->time != copy->time)
+        legacy_wheel_copy_reset( "core button release boundary" );
+}
