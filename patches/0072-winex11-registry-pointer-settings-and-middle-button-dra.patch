Subject: winex11: add pointer settings and middle-button navigation

Read the six pointer settings once when the process starts. A launch
environment variable has first priority, followed by the application's Wine
registry values, the global Wine registry values, and the built-in default.
Reject unknown names and invalid rates without changing the selected value.

Turn a middle-button drag into vertical and horizontal wheel input. A normal
middle click remains a click. Twenty-four raw screen pixels equal one notch,
and one input report cannot emit more than one notch per axis. Discard excess
movement from a larger report instead of replaying it later. Keep drag state on
the Wine interface thread and move the cursor to the real point on release.

See notes/ABLETON-WINE-POINTER-GESTURES.md for the settings and review order.
---
diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index 2c394b6..807ae1e 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -30,6 +30,7 @@
 #include <X11/Xlib.h>
 #include <X11/cursorfont.h>
 #include <stdarg.h>
+#include <stdlib.h>
 #ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
 #include <X11/extensions/XInput2.h>
 #endif
@@ -557,6 +558,235 @@ static void send_mouse_input( HWND hwnd, POINT pos, UINT flags, UINT data, UINT
     NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT, &input, (LPARAM)raw );
 }
 
+/***********************************************************************
+ *           send_wheel_only_input
+ *
+ * Send wheel input with no position: with neither MOUSEEVENTF_ABSOLUTE nor
+ * a nonzero point, send_mouse_input() adds no MOUSEEVENTF_MOVE, and the
+ * server stamps the message at the current cursor position. Wheel delivery
+ * through this helper never moves the cursor or the hover state.
+ */
+static void send_wheel_only_input( HWND hwnd, UINT flags, int delta, UINT time )
+{
+    POINT pos = { 0, 0 };
+    send_mouse_input( hwnd, pos, flags, delta, time, NULL );
+}
+
+/* movement one wheel notch stands for, in raw virtual screen pixels */
+#define MIDDLE_DRAG_STEP 24
+
+/***********************************************************************
+ *           middle_drag_enabled
+ *
+ * MiddleDrag=navigate turns a middle-button drag into navigation input:
+ * vertical movement becomes wheel notches, horizontal movement becomes
+ * horizontal wheel notches, and no modifier is added. This is the
+ * default; MiddleDrag=disabled restores plain WM_MBUTTONDOWN and
+ * WM_MBUTTONUP reporting.
+ */
+static BOOL middle_drag_enabled(void)
+{
+    return pointer_config.middle_drag != POINTER_MIDDLE_DRAG_DISABLED;
+}
+
+/***********************************************************************
+ *           middle_drag_notched
+ *
+ * MiddleDrag=navigate-notched reports whole wheel notches instead of
+ * following the pointer continuously, for an application that ignores the
+ * part of a notch a precision pointing device reports.
+ */
+static BOOL middle_drag_notched(void)
+{
+    return pointer_config.middle_drag == POINTER_MIDDLE_DRAG_NAVIGATE_NOTCHED;
+}
+
+/***********************************************************************
+ *           middle_drag_flush_click
+ *
+ * Replay a held-back press that never moved as a plain middle click: the
+ * down stamped with the time and at the position the press landed on, the
+ * up with the time it is let go.
+ */
+static void middle_drag_flush_click( UINT time )
+{
+    struct x11drv_middle_drag *drag = &x11drv_thread_data()->middle_drag;
+
+    if (drag->moved) return;
+    send_mouse_input( drag->hwnd, drag->origin,
+                      MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MIDDLEDOWN, 0, drag->time, NULL );
+    send_mouse_input( drag->hwnd, drag->origin,
+                      MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MIDDLEUP, 0, time, NULL );
+}
+
+/***********************************************************************
+ *           middle_drag_abort
+ *
+ * End a drag without its release: another button joined in, or the release
+ * was lost. A press that never moved is replayed as a click; a drag that
+ * reported wheel movement syncs the cursor to the real pointer position, so
+ * the input that follows lands there.
+ */
+static void middle_drag_abort( POINT pt, UINT time )
+{
+    struct x11drv_middle_drag *drag = &x11drv_thread_data()->middle_drag;
+
+    middle_drag_flush_click( time );
+    if (drag->moved)
+        send_mouse_input( drag->hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+    drag->active = FALSE;
+}
+
+/***********************************************************************
+ *           middle_drag_begin
+ *
+ * Hold back a middle-button press. The release replays it as a plain click
+ * when the pointer stayed within the drag slop, so a middle click keeps
+ * working. A press of another button during a drag ends it instead and goes
+ * through, so a click placed mid-drag is not followed by motion a held-back
+ * drag keeps swallowing.
+ *
+ * The state lives in the thread data: the X implicit pointer grab on the
+ * press pins the whole drag's delivery to the window's owning thread, so
+ * concurrent drags on windows of different threads cannot share state.
+ */
+static BOOL middle_drag_begin( HWND hwnd, XButtonEvent *event, POINT pt, UINT time )
+{
+    struct x11drv_middle_drag *drag = &x11drv_thread_data()->middle_drag;
+
+    if (!middle_drag_enabled()) return FALSE;
+
+    if (drag->active)
+    {
+        if (event->button == Button2)
+            middle_drag_abort( pt, time );  /* a stale drag, its release was lost */
+        else
+        {
+            middle_drag_abort( pt, time );
+            return FALSE;
+        }
+    }
+    if (event->button != Button2) return FALSE;
+    if (event->state & (Button1Mask | Button3Mask)) return FALSE;
+
+    TRACE( "hwnd %p/%lx begin at %s\n", hwnd, event->window, wine_dbgstr_point( &pt ) );
+
+    drag->active = TRUE;
+    drag->moved = FALSE;
+    drag->hwnd = hwnd;
+    drag->time = time;
+    drag->origin = pt;
+    drag->last = pt;
+    drag->slop_x = NtUserGetSystemMetrics( SM_CXDRAG );
+    drag->slop_y = NtUserGetSystemMetrics( SM_CYDRAG );
+    drag->accum_x = drag->accum_y = 0;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           middle_drag_delta
+ *
+ * Convert accumulated raw pixels into wheel units, keeping the remainder.
+ * Bound one event to one notch per axis. A larger compositor-coalesced jump
+ * is discarded after that notch instead of becoming queued movement debt.
+ * The notched variant floors sub-notch movement and carries that remainder.
+ */
+static int middle_drag_delta( int *accum, BOOL notched )
+{
+    int delta;
+
+    if (*accum >= MIDDLE_DRAG_STEP) { *accum = 0; return WHEEL_DELTA; }
+    if (*accum <= -MIDDLE_DRAG_STEP) { *accum = 0; return -WHEEL_DELTA; }
+    delta = *accum * WHEEL_DELTA / MIDDLE_DRAG_STEP;
+
+    if (notched) delta = (delta / WHEEL_DELTA) * WHEEL_DELTA;
+    *accum -= delta * MIDDLE_DRAG_STEP / WHEEL_DELTA;
+    return delta;
+}
+
+/***********************************************************************
+ *           middle_drag_motion
+ *
+ * Report movement during a middle-button drag as wheel input and keep the
+ * movement itself from the application. Each axis reports its own wheel:
+ * vertical movement becomes wheel units, horizontal movement becomes
+ * horizontal wheel units, and no modifier is added; a Ctrl the user holds
+ * during the drag reaches the message through the desktop key state, which
+ * turns the same drag into whatever the application does for Ctrl+wheel.
+ *
+ * The movement is measured in raw virtual screen pixels: map_event_coords()
+ * reports MDT_RAW_DPI coordinates with no DPI normalization, so one notch
+ * is a fixed physical distance and covers less of a window's content the
+ * more the display is scaled up. The drag slop comes from SM_CXDRAG and
+ * SM_CYDRAG and is measured against the press origin, so a slow drag in
+ * small steps becomes a drag all the same.
+ *
+ * Wheel output goes through the wheel-only helper: the swallowed motion
+ * leaves the server cursor at the press origin, so every wheel message is
+ * stamped there and the panned region stays the hit-test target for the
+ * whole drag.
+ */
+static BOOL middle_drag_motion( XMotionEvent *event, POINT pt, UINT time )
+{
+    struct x11drv_middle_drag *drag = &x11drv_thread_data()->middle_drag;
+    BOOL notched = middle_drag_notched();
+    int delta;
+
+    if (!drag->active) return FALSE;
+    if (!(event->state & Button2Mask) ||                /* the release went somewhere else */
+        (event->state & (Button1Mask | Button3Mask)))   /* another button joined in */
+    {
+        middle_drag_abort( pt, time );
+        return FALSE;
+    }
+
+    drag->accum_x += pt.x - drag->last.x;
+    drag->accum_y += pt.y - drag->last.y;
+    drag->last = pt;
+    if (!drag->moved)
+    {
+        if (abs( pt.x - drag->origin.x ) <= drag->slop_x &&
+            abs( pt.y - drag->origin.y ) <= drag->slop_y) return TRUE;
+        drag->moved = TRUE;
+    }
+
+    if ((delta = middle_drag_delta( &drag->accum_y, notched )))  /* up scrolls up */
+    {
+        TRACE( "hwnd %p wheel delta %d\n", drag->hwnd, -delta );
+        send_wheel_only_input( drag->hwnd, MOUSEEVENTF_WHEEL, -delta, time );
+    }
+    if ((delta = middle_drag_delta( &drag->accum_x, notched )))  /* right scrolls right */
+    {
+        TRACE( "hwnd %p hwheel delta %d\n", drag->hwnd, delta );
+        send_wheel_only_input( drag->hwnd, MOUSEEVENTF_HWHEEL, delta, time );
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           middle_drag_end
+ *
+ * Let a held-back press go. A press that never moved is replayed as a plain
+ * click at the position the press landed on. After a drag the cursor is
+ * synced to the X11 release coordinates, so the input that follows lands
+ * where the pointer really is.
+ */
+static BOOL middle_drag_end( XButtonEvent *event, POINT pt, UINT time )
+{
+    struct x11drv_middle_drag *drag = &x11drv_thread_data()->middle_drag;
+
+    if (!drag->active) return FALSE;
+    if (event->button != Button2) return FALSE;
+
+    TRACE( "hwnd %p/%lx end, moved %u\n", drag->hwnd, event->window, drag->moved );
+
+    middle_drag_flush_click( time );
+    if (drag->moved)
+        send_mouse_input( drag->hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+    drag->active = FALSE;
+    return TRUE;
+}
+
 #ifdef SONAME_LIBXCURSOR
 
 /***********************************************************************
@@ -1526,6 +1756,7 @@ BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
     }
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (middle_drag_begin( hwnd, event, pt, time )) return TRUE;
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_down_data[button], time, NULL );
     return TRUE;
 }
@@ -1545,6 +1776,7 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
     TRACE( "hwnd %p/%lx button %u pos %s\n", hwnd, event->window, button, wine_dbgstr_point( &pt ) );
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (middle_drag_end( event, pt, time )) return TRUE;
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_up_data[button], time, NULL );
     return TRUE;
 }
@@ -1569,6 +1801,7 @@ BOOL X11DRV_MotionNotify( HWND hwnd, XEvent *xev )
     }
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (middle_drag_motion( event, pt, time )) return TRUE;
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
     return TRUE;
 }
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 34b53ce..340aca7 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -411,6 +411,69 @@ struct display_state
     Window net_active_window;
 };
 
+/* pointer feature configuration, resolved once at process attach from
+ * HKCU\Software\Wine\X11 Driver (with the AppDefaults overlay), with the
+ * matching WINE_X11_* environment variable as a one-launch override */
+
+enum pointer_scroll_mode
+{
+    POINTER_SCROLL_DISABLED,   /* core wheel buttons only, one whole notch per press */
+    POINTER_SCROLL_PRECISE,    /* fractional wheel units from XInput2 scroll valuators */
+    POINTER_SCROLL_NOTCHED,    /* scroll valuators floored to whole notches, remainder carried */
+};
+
+enum pointer_inertia_mode
+{
+    POINTER_INERTIA_DISABLED,  /* scrolling stops when the reports stop */
+    POINTER_INERTIA_AUTO,      /* coast only when the source is positively a touchpad */
+    POINTER_INERTIA_ENABLED,   /* coast after any non-emulated smooth scroll sequence */
+};
+
+enum pointer_pinch_mode
+{
+    POINTER_PINCH_DISABLED,     /* gesture events stay with the X server */
+    POINTER_PINCH_LEGACY_WHEEL, /* pinch reports become Ctrl-tagged wheel input */
+};
+
+enum pointer_middle_drag_mode
+{
+    POINTER_MIDDLE_DRAG_DISABLED,         /* middle button reports plain clicks */
+    POINTER_MIDDLE_DRAG_NAVIGATE,         /* drag reports fractional wheel input */
+    POINTER_MIDDLE_DRAG_NAVIGATE_NOTCHED, /* drag reports whole notches, remainder carried */
+};
+
+enum pointer_inertia_curve
+{
+    POINTER_INERTIA_CURVE_EXPONENTIAL,
+    POINTER_INERTIA_CURVE_LINEAR,
+};
+
+struct x11drv_pointer_config
+{
+    enum pointer_scroll_mode      smooth_scrolling;
+    enum pointer_inertia_mode     touchpad_inertia;
+    enum pointer_pinch_mode       pinch_zoom;
+    enum pointer_middle_drag_mode middle_drag;
+    enum pointer_inertia_curve    inertia_curve;
+    double                        inertia_rate;  /* exponential decay rate coefficient, 1/s */
+};
+
+extern struct x11drv_pointer_config pointer_config;
+
+struct x11drv_middle_drag
+{
+    BOOL  active;
+    BOOL  moved;       /* the pointer left the click slop, the press became a drag */
+    HWND  hwnd;        /* window the press landed on */
+    UINT  time;        /* when the press was held back */
+    POINT origin;      /* position the press landed on, virtual screen coordinates */
+    POINT last;        /* previous position, in the same coordinates */
+    int   slop_x;      /* SM_CXDRAG at the press, movement within it stays a click */
+    int   slop_y;      /* SM_CYDRAG at the press */
+    int   accum_x;     /* raw pixels not yet reported as wheel units */
+    int   accum_y;
+};
+
 struct x11drv_thread_data
 {
     Display *display;
@@ -427,6 +490,7 @@ struct x11drv_thread_data
     Atom    *net_supported;        /* list of _NET_SUPPORTED atoms */
     int      net_supported_count;  /* number of _NET_SUPPORTED atoms */
     UINT     net_wm_state_mask;    /* mask of supported _NET_WM_STATE *bits */
+    struct x11drv_middle_drag middle_drag;  /* middle-button drag navigation state */
 #ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
     XIValuatorClassInfo x_valuator;
     XIValuatorClassInfo y_valuator;
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index 500a013..f0cc453 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -26,6 +26,7 @@
 #include "config.h"
 
 #include <fcntl.h>
+#include <math.h>
 #include <stdarg.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -412,6 +413,166 @@ static inline DWORD get_config_key( HKEY defkey, HKEY appkey, const char *name,
 }
 
 
+/* pointer feature configuration; the built-in defaults apply when neither
+ * the registry nor the environment names a value */
+struct x11drv_pointer_config pointer_config =
+{
+    .smooth_scrolling = POINTER_SCROLL_PRECISE,
+    .touchpad_inertia = POINTER_INERTIA_ENABLED,
+    .pinch_zoom       = POINTER_PINCH_LEGACY_WHEEL,
+    .middle_drag      = POINTER_MIDDLE_DRAG_NAVIGATE,
+    .inertia_curve    = POINTER_INERTIA_CURVE_EXPONENTIAL,
+    .inertia_rate     = 4.0,
+};
+
+/* Earlier development builds of these features read different names, and
+ * nothing maps them to the current ones. Warn where the launcher's
+ * default debug options keep the line visible instead of ignoring the
+ * setting */
+static const struct { const char *legacy, *current; } legacy_env_names[] =
+{
+    { "WINE_X11_SMOOTH_SCROLL",           "WINE_X11_SMOOTH_SCROLLING" },
+    { "WINE_X11_SCROLL_INERTIA",          "WINE_X11_TOUCHPAD_INERTIA" },
+    { "WINE_X11_SCROLL_INERTIA_FRICTION", "WINE_X11_INERTIA_RATE" },
+    { "WINE_X11_SCROLL_INERTIA_CURVE",    "WINE_X11_INERTIA_CURVE" },
+};
+
+static void warn_legacy_env_names(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE( legacy_env_names ); i++)
+    {
+        if (!getenv( legacy_env_names[i].legacy )) continue;
+        WARN_(winediag)( "%s is set but this driver no longer reads it; use %s instead\n",
+                         legacy_env_names[i].legacy, legacy_env_names[i].current );
+    }
+}
+
+/***********************************************************************
+ *		pointer_option_string
+ *
+ * Resolve one pointer setting to an ASCII string. The environment variable
+ * is an explicit one-launch override and outranks the registry; inside the
+ * registry, get_config_key() gives the AppDefaults key precedence over the
+ * global key. Returns FALSE when neither source names a value.
+ */
+static BOOL pointer_option_string( HKEY defkey, HKEY appkey, const char *name, const char *env,
+                                   char *buffer, size_t size, const char **source )
+{
+    WCHAR valueW[64];
+    const char *value;
+    size_t i;
+
+    if ((value = getenv( env )))
+    {
+        snprintf( buffer, size, "%s", value );
+        *source = "environment";
+        return TRUE;
+    }
+    if (!get_config_key( defkey, appkey, name, valueW, sizeof(valueW) ))
+    {
+        /* the vocabulary is ASCII; anything else must not match a keyword */
+        for (i = 0; i < size - 1 && valueW[i]; i++)
+            buffer[i] = valueW[i] < 128 ? (char)valueW[i] : '?';
+        buffer[i] = 0;
+        *source = "registry";
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/***********************************************************************
+ *		pointer_option_enum
+ *
+ * Match a setting against its value vocabulary, indexed by enum value. A
+ * value outside the vocabulary warns and keeps the default: an option that
+ * exists to disable a feature must never enable it through a near miss.
+ */
+static void pointer_option_enum( HKEY defkey, HKEY appkey, const char *name, const char *env,
+                                 const char *const *names, int count, int *result )
+{
+    char buffer[64];
+    const char *source;
+    int i;
+
+    if (!pointer_option_string( defkey, appkey, name, env, buffer, sizeof(buffer), &source ))
+    {
+        TRACE( "%s = %s (default)\n", name, names[*result] );
+        return;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (strcmp( buffer, names[i] )) continue;
+        *result = i;
+        TRACE( "%s = %s (%s)\n", name, names[i], source );
+        return;
+    }
+    WARN( "unrecognized %s value %s from the %s, keeping %s\n",
+          name, debugstr_a( buffer ), source, names[*result] );
+}
+
+/***********************************************************************
+ *		setup_pointer_options
+ *
+ * Parse the pointer feature settings once into pointer_config.
+ */
+static void setup_pointer_options( HKEY defkey, HKEY appkey )
+{
+    static const char *const scroll_names[] = { "disabled", "precise", "notched" };
+    static const char *const inertia_names[] = { "disabled", "auto", "enabled" };
+    static const char *const pinch_names[] = { "disabled", "legacy-wheel" };
+    static const char *const drag_names[] = { "disabled", "navigate", "navigate-notched" };
+    static const char *const curve_names[] = { "exponential", "linear" };
+    char buffer[64], *end;
+    const char *source;
+    double parsed;
+    int value;
+
+    warn_legacy_env_names();
+
+    value = pointer_config.smooth_scrolling;
+    pointer_option_enum( defkey, appkey, "SmoothScrolling", "WINE_X11_SMOOTH_SCROLLING",
+                         scroll_names, ARRAY_SIZE( scroll_names ), &value );
+    pointer_config.smooth_scrolling = value;
+
+    value = pointer_config.touchpad_inertia;
+    pointer_option_enum( defkey, appkey, "TouchpadInertia", "WINE_X11_TOUCHPAD_INERTIA",
+                         inertia_names, ARRAY_SIZE( inertia_names ), &value );
+    pointer_config.touchpad_inertia = value;
+
+    value = pointer_config.pinch_zoom;
+    pointer_option_enum( defkey, appkey, "PinchZoom", "WINE_X11_PINCH_ZOOM",
+                         pinch_names, ARRAY_SIZE( pinch_names ), &value );
+    pointer_config.pinch_zoom = value;
+
+    value = pointer_config.middle_drag;
+    pointer_option_enum( defkey, appkey, "MiddleDrag", "WINE_X11_MIDDLE_DRAG",
+                         drag_names, ARRAY_SIZE( drag_names ), &value );
+    pointer_config.middle_drag = value;
+
+    value = pointer_config.inertia_curve;
+    pointer_option_enum( defkey, appkey, "InertiaCurve", "WINE_X11_INERTIA_CURVE",
+                         curve_names, ARRAY_SIZE( curve_names ), &value );
+    pointer_config.inertia_curve = value;
+
+    if (pointer_option_string( defkey, appkey, "InertiaRate", "WINE_X11_INERTIA_RATE",
+                               buffer, sizeof(buffer), &source ))
+    {
+        parsed = strtod( buffer, &end );
+        if (end == buffer || *end || !isfinite( parsed ) || parsed < 0.5 || parsed > 16.0)
+            WARN( "InertiaRate value %s from the %s is not a decimal in [0.5, 16.0], keeping %.1f\n",
+                  debugstr_a( buffer ), source, pointer_config.inertia_rate );
+        else
+        {
+            pointer_config.inertia_rate = parsed;
+            TRACE( "InertiaRate = %.2f (%s)\n", parsed, source );
+        }
+    }
+    else TRACE( "InertiaRate = %.2f (default)\n", pointer_config.inertia_rate );
+}
+
+
 /***********************************************************************
  *		setup_options
  *
@@ -505,6 +666,8 @@ static void setup_options(void)
 
     get_config_key( hkey, appkey, "InputStyle", input_style, sizeof(input_style) );
 
+    setup_pointer_options( hkey, appkey );
+
     NtClose( appkey );
     NtClose( hkey );
 }

