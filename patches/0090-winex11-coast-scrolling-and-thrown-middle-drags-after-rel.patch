+/* scroll inertia: coast after a fast touchpad sequence ends (on by default)
+ *
+ * All state lives in the owning GUI thread's data and every wheel event is
+ * emitted from that thread. The only foreign thread is a nudger whose sole
+ * job is posting WM_X11DRV_POINTER_TICK to the sequence's window: win32u
+ * routes driver-range messages to the driver on the window's own thread and
+ * the application never sees them. A stray post after a cancel finds the
+ * tracker idle and does nothing, so there is no cross-thread race to lose.
+ */
+
+#define INERTIA_HISTORY_MS   100     /* velocity comes from this much tail */
+#define INERTIA_DEADLINE_MS  100     /* quiet time that ends a sequence without a lift marker */
+#define INERTIA_RELEASE_GATE_MS 70   /* a positive end this long after the last sample means
+                                        the fingers were resting, not flicking (observed
+                                        genuine lift gaps are 3 to 29 ms) */
+#define INERTIA_TICK_MS      8
+#define INERTIA_CAP_MS       3000    /* longest coast before the decay is forced steeper */
+#define INERTIA_CAP_RATE     14.0    /* decay rate past the cap, an exhale instead of a stop */
+#define INERTIA_START_SPEED  240.0   /* wheel units per second, vector magnitude */
+#define INERTIA_STOP_SPEED   60.0
+#define INERTIA_MAX_SPEED    19200.0
+
+#define INERTIA_NUDGE_SLOTS 8
+
+static pthread_mutex_t inertia_nudge_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t inertia_nudge_cond = PTHREAD_COND_INITIALIZER;
+static struct
+{
+    struct
+    {
+        HWND   hwnd;      /* post target, 0 = free slot */
+        UINT64 fire_at;   /* CLOCK_MONOTONIC milliseconds */
+        UINT   interval;
+        BOOL   repeating; /* deadlines post once, coasting ticks repeat */
+    } slots[INERTIA_NUDGE_SLOTS];
+    BOOL running;
+    BOOL failed;
+} inertia_nudge;
+
+static UINT64 inertia_nudge_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (UINT64)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void CALLBACK inertia_nudge_thread( void *arg )
+{
+    pthread_mutex_lock( &inertia_nudge_mutex );
+    for (;;)
+    {
+        UINT64 now, min_fire = 0;
+        int i;
+
+        for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+            if (inertia_nudge.slots[i].hwnd &&
+                (!min_fire || inertia_nudge.slots[i].fire_at < min_fire))
+                min_fire = inertia_nudge.slots[i].fire_at;
+
+        if (!min_fire)
+        {
+            pthread_cond_wait( &inertia_nudge_cond, &inertia_nudge_mutex );
+            continue;
+        }
+
+        now = inertia_nudge_now();
+        if (now < min_fire)
+        {
+            struct timespec deadline;
+
+            deadline.tv_sec = min_fire / 1000;
+            deadline.tv_nsec = (min_fire % 1000) * 1000000;
+            pthread_cond_timedwait( &inertia_nudge_cond, &inertia_nudge_mutex, &deadline );
+            continue;  /* recompute: the slots may have changed either way */
+        }
+
+        for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+        {
+            HWND hwnd = inertia_nudge.slots[i].hwnd;
+            BOOL ok;
+
+            if (!hwnd || inertia_nudge.slots[i].fire_at > now) continue;
+            if (inertia_nudge.slots[i].repeating)
+                inertia_nudge.slots[i].fire_at = now + inertia_nudge.slots[i].interval;
+            else
+                inertia_nudge.slots[i].hwnd = 0;  /* one shot */
+            pthread_mutex_unlock( &inertia_nudge_mutex );
+            ok = NtUserPostMessage( hwnd, WM_X11DRV_POINTER_TICK, 0, 0 );
+            pthread_mutex_lock( &inertia_nudge_mutex );
+            if (!ok)  /* window gone: drop every schedule it holds */
+            {
+                int j;
+
+                for (j = 0; j < INERTIA_NUDGE_SLOTS; j++)
+                    if (inertia_nudge.slots[j].hwnd == hwnd) inertia_nudge.slots[j].hwnd = 0;
+            }
+        }
+    }
+}
+
+/***********************************************************************
+ *           inertia_nudge_arm
+ *
+ * Register or move one window's next tick. Slots are keyed by window, so
+ * trackers on different GUI threads schedule independently, and every
+ * access runs under the mutex. The nudger only wakes when a schedule
+ * moves earlier than the slot held before; a deadline re-armed later
+ * needs no wake, because the sleep target was already sooner.
+ */
+static void inertia_nudge_arm( HWND hwnd, UINT interval, BOOL repeating )
+{
+    UINT64 fire_at;
+    int i, slot = -1, latest = -1;
+    BOOL wake;
+
+    if (!hwnd) return;
+    pthread_mutex_lock( &inertia_nudge_mutex );
+    if (!inertia_nudge.running && !inertia_nudge.failed)
+    {
+        pthread_condattr_t attr;
+        HANDLE thread;
+
+        /* the waits must not follow wall-clock steps (an ntp correction
+         * would stall a deadline or freeze a coast by the step size);
+         * re-initializing the static cond is safe here, before the only
+         * waiter thread exists */
+        if (!pthread_condattr_init( &attr ) &&
+            !pthread_condattr_setclock( &attr, CLOCK_MONOTONIC ))
+        {
+            pthread_cond_init( &inertia_nudge_cond, &attr );
+            pthread_condattr_destroy( &attr );
+        }
+
+        /* NtCreateThreadEx is what the unix side of ntdll exports; the
+         * thread must be a Wine thread to make win32u calls */
+        if (NtCreateThreadEx( &thread, THREAD_ALL_ACCESS, NULL, NtCurrentProcess(),
+                              inertia_nudge_thread, NULL, 0, 0, 0, 0, NULL ))
+        {
+            WARN( "failed to start the inertia nudge thread, inertia disabled\n" );
+            inertia_nudge.failed = TRUE;
+        }
+        else
+        {
+            NtClose( thread );
+            inertia_nudge.running = TRUE;
+        }
+    }
+    if (inertia_nudge.failed)
+    {
+        pthread_mutex_unlock( &inertia_nudge_mutex );
+        return;
+    }
+
+    for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+    {
+        if (inertia_nudge.slots[i].hwnd == hwnd) { slot = i; break; }
+        if (slot == -1 && !inertia_nudge.slots[i].hwnd) slot = i;
+        if (latest == -1 || inertia_nudge.slots[i].fire_at > inertia_nudge.slots[latest].fire_at)
+            latest = i;
+    }
+    if (slot == -1)
+    {
+        /* every slot belongs to another window: take over the schedule
+         * firing last; its tracker recovers on that thread's next input */
+        TRACE( "nudge slots full, dropping the schedule of %p\n", inertia_nudge.slots[latest].hwnd );
+        slot = latest;
+        inertia_nudge.slots[slot].hwnd = 0;
+    }
+
+    fire_at = inertia_nudge_now() + interval;
+    wake = !inertia_nudge.slots[slot].hwnd || fire_at < inertia_nudge.slots[slot].fire_at;
+    inertia_nudge.slots[slot].hwnd = hwnd;
+    inertia_nudge.slots[slot].fire_at = fire_at;
+    inertia_nudge.slots[slot].interval = interval;
+    inertia_nudge.slots[slot].repeating = repeating;
+    if (wake) pthread_cond_signal( &inertia_nudge_cond );
+    pthread_mutex_unlock( &inertia_nudge_mutex );
+}
+
+/* drop one window's schedule; the nudger wakes at the stale time and
+ * finds nothing due, so no signal is needed */
+static void inertia_nudge_stop( HWND hwnd )
+{
+    int i;
+
+    if (!hwnd) return;
+    pthread_mutex_lock( &inertia_nudge_mutex );
+    for (i = 0; i < INERTIA_NUDGE_SLOTS; i++)
+        if (inertia_nudge.slots[i].hwnd == hwnd) inertia_nudge.slots[i].hwnd = 0;
+    pthread_mutex_unlock( &inertia_nudge_mutex );
+}
+
+static BOOL pointer_inertia_enabled(void)
+{
+    /* auto stays disabled on XInput2: ScrollClass has no source field and
+     * XWayland discards the Wayland axis source, so a touchpad cannot be
+     * told from a free-spinning or high-resolution wheel here. enabled is
+     * the explicit opt-in. The scroll path additionally requires the
+     * precise mode, whose fractional stream a fling can be measured from;
+     * the middle drag always has raw pixel deltas and needs no such gate. */
+    return pointer_config.touchpad_inertia == POINTER_INERTIA_ENABLED;
+}
+
+/***********************************************************************
+ *           pointer_inertia_cancel
+ *
+ * Any real input or context change ends tracking and coasting: pointer
+ * motion, button and key input, focus loss, grabs, device changes. Runs on
+ * the owning thread, so a plain state write is enough.
+ */
+void pointer_inertia_cancel(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+
+    if (!data) return;
+    if (data->scroll_inertia.state == INERTIA_IDLE) return;
+    TRACE( "state %u cancelled\n", data->scroll_inertia.state );
+    data->scroll_inertia.state = INERTIA_IDLE;
+    data->scroll_inertia.count = 0;
+    inertia_nudge_stop( data->scroll_inertia.hwnd );
+}
+
+/***********************************************************************
+ *           pointer_inertia_sample
+ *
+ * Record one accepted smooth scroll report: the raw fractional wheel units
+ * in the sign they were sent, stamped with the event's own time. A report
+ * from another device restarts tracking, and a report during a coast ends
+ * the coast first, so a new touch always wins over a running fling. Each
+ * sample re-arms the one-shot release deadline.
+ */
+static void pointer_inertia_sample( struct x11drv_thread_data *data, int sourceid, HWND hwnd,
+                                    double dx, double dy, UINT time )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+    unsigned int i;
+
+    if (!pointer_inertia_enabled()) return;
+
+    if (si->state == INERTIA_COASTING || (si->state == INERTIA_TRACKING && si->sourceid != sourceid))
+    {
+        si->state = INERTIA_IDLE;
+        si->count = 0;
+    }
+    si->state = INERTIA_TRACKING;
+    si->sourceid = sourceid;
+    si->hwnd = hwnd;
+    si->last_time = time;
+
+    if (si->count == INERTIA_HISTORY_SIZE)
+        si->pos = (si->pos + 1) % INERTIA_HISTORY_SIZE;
+    else
+        si->count++;
+    i = (si->pos + si->count - 1) % INERTIA_HISTORY_SIZE;
+    si->history[i].dx = dx;
+    si->history[i].dy = dy;
+    si->history[i].time = time;
+
+    /* an upsert per sample is a plain mutexed write; the nudger itself
+     * only wakes when a schedule moves earlier, and a deadline pushed
+     * later never does */
+    inertia_nudge_arm( hwnd, INERTIA_DEADLINE_MS, FALSE );
+}
+
+/***********************************************************************
+ *           pointer_inertia_evaluate
+ *
+ * Decide whether the ended sequence flings. The velocity is the summed raw
+ * deltas of the trailing history over the interval they actually cover,
+ * measured with the events' own timestamps: a late evaluation cannot
+ * underestimate it, and rounding losses cannot accumulate in it.
+ */
+static void pointer_inertia_evaluate( struct x11drv_thread_data *data, UINT now, BOOL deadline )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+    double sum_x = 0.0, sum_y = 0.0, vx, vy, speed;
+    UINT first = 0, last = 0, span;
+    unsigned int i, used = 0;
+
+    for (i = 0; i < si->count; i++)
+    {
+        unsigned int j = (si->pos + i) % INERTIA_HISTORY_SIZE;
+
+        if (si->last_time - si->history[j].time > INERTIA_HISTORY_MS) continue;
+        if (!used)
+        {
+            /* the first sample's delta accrued before the window opens;
+             * its timestamp anchors the span, its movement does not count */
+            first = si->history[j].time;
+            last = first;
+            used++;
+            continue;
+        }
+        last = si->history[j].time;
+        sum_x += si->history[j].dx;
+        sum_y += si->history[j].dy;
+        used++;
+    }
+
+    si->state = INERTIA_IDLE;
+    si->count = 0;
+
+    span = last - first;
+    if (used < 2 || span < 10) return;
+
+    vx = sum_x * 1000.0 / span;
+    vy = sum_y * 1000.0 / span;
+    speed = hypot( vx, vy );
+    if (speed < INERTIA_START_SPEED)
+    {
+        TRACE( "sequence ended at %f units/s, no fling\n", speed );
+        return;
+    }
+    if (speed > INERTIA_MAX_SPEED)
+    {
+        vx *= INERTIA_MAX_SPEED / speed;
+        vy *= INERTIA_MAX_SPEED / speed;
+    }
+
+    si->state = INERTIA_COASTING;
+    si->deadline_fling = deadline;
+    si->vx = si->v0x = vx;
+    si->vy = si->v0y = vy;
+    si->rem_x = si->rem_y = 0.0;
+    si->start_time = si->last_tick = now;
+
+    TRACE( "fling start velocity %f,%f units/s%s\n", vx, vy, deadline ? " (deadline)" : "" );
+
+    inertia_nudge_arm( si->hwnd, INERTIA_TICK_MS, TRUE );
+}
+
+/***********************************************************************
+ *           pointer_inertia_release
+ *
+ * The tracked sequence ended positively: a finger lift marker from the
+ * scroll path, or the middle button releasing a drag. Evaluate the fling
+ * right away instead of waiting for the quiet deadline.
+ */
+static void pointer_inertia_release( struct x11drv_thread_data *data, int sourceid, UINT time )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+
+    if (si->state != INERTIA_TRACKING || si->sourceid != sourceid) return;
+    if (time - si->last_time > INERTIA_RELEASE_GATE_MS)
+    {
+        /* the fingers rested before lifting: stopping precisely must stop
+         * precisely, however fast the movement before the rest was */
+        TRACE( "release from source %d after %u ms of rest, no fling\n",
+               sourceid, time - si->last_time );
+        si->state = INERTIA_IDLE;
+        si->count = 0;
+        inertia_nudge_stop( si->hwnd );
+        return;
+    }
+    TRACE( "release from source %d\n", sourceid );
+    pointer_inertia_evaluate( data, time, FALSE );
+}
+
+/* a zero-delta report on a present scroll axis: the compositor's finger
+ * lift marker, forwarded by XWayland from the Wayland axis stop */
+static void pointer_inertia_stop_marker( struct x11drv_thread_data *data, int sourceid, UINT time )
+{
+    struct x11drv_scroll_inertia *si = &data->scroll_inertia;
+
+    if (!pointer_inertia_enabled()) return;
+
+    /* a marker means the fingers were still down a moment ago; if a quiet
+     * deadline already launched a coast for this source, that coast was a
+     * phantom (fingers resting, not lifted) - kill it */
+    if (si->state == INERTIA_COASTING && si->sourceid == sourceid && si->deadline_fling &&
+        time - si->last_time > INERTIA_RELEASE_GATE_MS)
+    {
+        TRACE( "late lift marker from source %d cancels a deadline fling\n", sourceid );
+        pointer_inertia_cancel();
+        return;
+    }
+    pointer_inertia_release( data, sourceid, time );
+}
+
+/***********************************************************************
+ *           pointer_inertia_tick
+ *
+ * Runs on the owning thread for every WM_X11DRV_POINTER_TICK the nudger
+ * posts. During tracking it is the release deadline for sequences without
+ * a lift marker; during coasting it integrates the decay analytically over
+ * the measured interval, so total travel does not depend on tick timing,
+ * and emits the whole wheel units, carrying the remainder.
+ */
+void pointer_inertia_tick(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_inertia *si;
+    UINT now = NtGetTickCount();
+    double dt, k = pointer_config.inertia_rate;
+    int delta;
+
+    if (!data) return;
+    si = &data->scroll_inertia;
+
+    switch (si->state)
+    {
+    case INERTIA_IDLE:
+        return;
+    case INERTIA_TRACKING:
+        if (now - si->last_time >= INERTIA_DEADLINE_MS)
+        {
+            /* a middle drag has no quiet end: it ends by release or abort,
+             * which evaluate or cancel themselves. going quiet under the
+             * held button means the user paused, and a pause never throws */
+            if (si->sourceid == INERTIA_SOURCE_MIDDLE_DRAG)
+            {
+                si->state = INERTIA_IDLE;
+                si->count = 0;
+                inertia_nudge_stop( si->hwnd );
+            }
+            else pointer_inertia_evaluate( data, now, TRUE );
+        }
+        else  /* an early post, e.g. from a re-arm race: keep the deadline */
+            inertia_nudge_arm( si->hwnd, INERTIA_DEADLINE_MS - (now - si->last_time), FALSE );
+        return;
+    case INERTIA_COASTING:
+        break;
+    }
+
+    if (!(dt = (now - si->last_tick) / 1000.0)) return;
+    si->last_tick = now;
+
+    /* past the cap the fling exhales instead of stopping dead: a steep decay
+     * takes any remaining velocity to the stop floor within ~300 ms. the
+     * default rate reaches the floor well before the cap; only slow custom
+     * InertiaRate settings ever see this */
+    if (now - si->start_time > INERTIA_CAP_MS && k < INERTIA_CAP_RATE) k = INERTIA_CAP_RATE;
+
+    if (pointer_config.inertia_curve == POINTER_INERTIA_CURVE_LINEAR)
+    {
+        /* constant deceleration with the exponential curve's initial slope */
+        double dec_x = k * fabs( si->v0x ) * dt, dec_y = k * fabs( si->v0y ) * dt;
+        double new_vx, new_vy;
+
+        if (si->vx > 0) new_vx = si->vx - dec_x > 0 ? si->vx - dec_x : 0;
+        else new_vx = si->vx + dec_x < 0 ? si->vx + dec_x : 0;
+        if (si->vy > 0) new_vy = si->vy - dec_y > 0 ? si->vy - dec_y : 0;
+        else new_vy = si->vy + dec_y < 0 ? si->vy + dec_y : 0;
+        si->rem_x += (si->vx + new_vx) / 2.0 * dt;
+        si->rem_y += (si->vy + new_vy) / 2.0 * dt;
+        si->vx = new_vx;
+        si->vy = new_vy;
+    }
+    else
+    {
+        /* v1 = v0 e^(-k dt); dx = v0 (1 - e^(-k dt)) / k */
+        double factor = exp( -k * dt );
+
+        si->rem_x += si->vx * (1.0 - factor) / k;
+        si->rem_y += si->vy * (1.0 - factor) / k;
+        si->vx *= factor;
+        si->vy *= factor;
+    }
+
+    if ((delta = (int)si->rem_y))
+    {
+        si->rem_y -= delta;
+        TRACE( "coast wheel %d\n", delta );
+        send_wheel_only_input( NULL, MOUSEEVENTF_WHEEL, delta, now );
+    }
+    if ((delta = (int)si->rem_x))
+    {
+        si->rem_x -= delta;
+        TRACE( "coast hwheel %d\n", delta );
+        send_wheel_only_input( NULL, MOUSEEVENTF_HWHEEL, delta, now );
+    }
+
+    if (hypot( si->vx, si->vy ) < INERTIA_STOP_SPEED ||
+        now - si->start_time > INERTIA_CAP_MS + 1000)  /* backstop; the exhale ends it sooner */
+    {
+        TRACE( "fling ends at %f,%f units/s\n", si->vx, si->vy );
+        si->state = INERTIA_IDLE;
+        inertia_nudge_stop( si->hwnd );
+    }
+}
